// Declarations, the global environment and the local context.

enum Hints {
  HOpaque
  HAbbrev
  HRegular(Int)
}

enum Safety {
  SafeDecl
  UnsafeDecl
  PartialDecl
}

enum QuotKind {
  QType
  QCtor
  QLift
  QInd
}

struct RecRule {
  ctor : Name
  nfields : Int
  rhs : Expr
}

struct InductVal {
  nparams : Int
  nindices : Int
  all : List[Name]
  ctors : List[Name]
  nnested : Int
  is_rec : Bool
  is_unsafe : Bool
  is_reflexive : Bool
}

struct CtorVal {
  induct : Name
  cidx : Int
  nparams : Int
  nfields : Int
  is_unsafe : Bool
}

struct RecVal {
  all : List[Name]
  nparams : Int
  nindices : Int
  nmotives : Int
  nminors : Int
  rules : List[RecRule]
  k : Bool
  is_unsafe : Bool
}

enum ConstKind {
  CAxiom(Bool)
  CDefn(Expr, Hints, Safety)
  CThm(Expr)
  COpaque(Expr, Bool)
  CQuot(QuotKind)
  CInduct(InductVal)
  CCtor(CtorVal)
  CRec(RecVal)
}

struct ConstInfo {
  name : Name
  lparams : List[Name]
  type : Expr
  kind : ConstKind
}

fn ConstInfo::is_unsafe(self : ConstInfo, k : K) -> Bool {
  match self.kind {
    CAxiom(u) => u
    CDefn(_, _, s) =>
      match s {
        UnsafeDecl => true
        _ => false
      }
    COpaque(_, u) => u
    CInduct(v) => v.is_unsafe
    CCtor(v) => v.is_unsafe
    CRec(v) => v.is_unsafe
    _ => false
  }
}

fn ConstInfo::is_partial(self : ConstInfo, k : K) -> Bool {
  match self.kind {
    CDefn(_, _, PartialDecl) => true
    _ => false
  }
}

// The value a constant unfolds to, if it is a definition (theorems are
// unfolded too, as in Lean 4; opaque constants never).
fn ConstInfo::delta_value(self : ConstInfo, k : K) -> Expr? {
  match self.kind {
    CDefn(v, _, _) => Some(v)
    CThm(v) => Some(v)
    _ => None
  }
}

fn ConstInfo::hints(self : ConstInfo, k : K) -> Hints {
  match self.kind {
    CDefn(_, h, _) => h
    _ => HOpaque
  }
}

fn ConstInfo::num_lparams(self : ConstInfo, k : K) -> Int {
  list_length(self.lparams)
}

// `h1 < h2` in the order used by lazy delta reduction: unfold the side
// with the greater height first.
fn hints_lt(h1 : Hints, h2 : Hints) -> Bool {
  match (h1, h2) {
    (HOpaque, HOpaque) => false
    (HOpaque, _) => true
    (HAbbrev, HAbbrev) => false
    (HAbbrev, _) => false
    (HRegular(_), HOpaque) => false
    (HRegular(_), HAbbrev) => true
    (HRegular(a), HRegular(b)) => a < b
  }
}

fn hints_is_regular(h : Hints) -> Bool {
  match h {
    HRegular(_) => true
    _ => false
  }
}

// ---- the environment ---------------------------------------------------------------

struct Env {
  consts : HashMap[Name, ConstInfo]
  mut quot_init : Bool
}

fn Env::new() -> Env {
  { consts: HashMap::new(), quot_init: false }
}

fn env_find(k : K, n : Name) -> ConstInfo? {
  k.env.consts.get(n)
}

fn env_get(k : K, n : Name) -> ConstInfo raise KernelError {
  match k.env.consts.get(n) {
    Some(ci) => ci
    None => kfail("unknown constant '\{n}'")
  }
}

fn env_contains(k : K, n : Name) -> Bool {
  k.env.consts.contains(n)
}

fn env_add(k : K, ci : ConstInfo) -> Unit {
  k.env.consts.set(ci.name, ci)
}

fn env_check_name(k : K, n : Name) -> Unit raise KernelError {
  if env_contains(k, n) {
    kfail("already declared: '\{n}'")
  }
}

fn env_find_induct(k : K, n : Name) -> InductVal? {
  match env_find(k, n) {
    Some({ kind: CInduct(v), .. }) => Some(v)
    _ => None
  }
}

fn env_find_ctor(k : K, n : Name) -> CtorVal? {
  match env_find(k, n) {
    Some({ kind: CCtor(v), .. }) => Some(v)
    _ => None
  }
}

// A non-recursive structure: one constructor, no indices.
fn is_structure_like(k : K, n : Name) -> Bool {
  match env_find_induct(k, n) {
    Some(v) => v.nindices == 0 && list_length(v.ctors) == 1
    None => false
  }
}

fn is_non_rec_structure(k : K, n : Name) -> Bool {
  match env_find_induct(k, n) {
    Some(v) => v.nindices == 0 && list_length(v.ctors) == 1 && not(v.is_rec)
    None => false
  }
}

// ---- the local context -----------------------------------------------------------------

struct LocalDecl {
  name : Name
  type : Expr
  // `-1` for a variable bound by a lambda or a pi; the value of a let otherwise
  value : Int
}

struct LCtx {
  decls : Array[LocalDecl]
}

fn LCtx::new() -> LCtx {
  { decls: Array::new() }
}

fn mk_local_decl(k : K, n : Name, t : Expr) -> Expr {
  k.lctx.decls.push({ name: n, type: t, value: -1 })
  mk_fvar(k, k.lctx.decls.length() - 1)
}

fn mk_let_decl(k : K, n : Name, t : Expr, v : Expr) -> Expr {
  k.lctx.decls.push({ name: n, type: t, value: v })
  mk_fvar(k, k.lctx.decls.length() - 1)
}

fn fvar_id(k : K, e : Expr) -> Int {
  k.arena.fa[e]
}

fn local_type(k : K, id : Int) -> Expr {
  k.lctx.decls[id].type
}

fn local_value(k : K, id : Int) -> Expr? {
  let v = k.lctx.decls[id].value
  if v < 0 { None } else { Some(v) }
}

// `(x1 : A1) -> ... -> e` over the free variables `xs` (outermost first);
// let variables become lets.
fn mk_binding(k : K, is_pi : Bool, xs : Array[Expr], e : Expr) -> Expr {
  let ids : Array[Int] = Array::new()
  for x in xs {
    ids.push(fvar_id(k, x))
  }
  let mut r = abstract_fvars(k, e, ids)
  for i = xs.length() - 1; i >= 0; i = i - 1 {
    let d = k.lctx.decls[ids[i]]
    // the type of `xs[i]` may mention `xs[0..i-1]`
    let prefix = ids.slice(0, i)
    let t = abstract_fvars(k, d.type, prefix)
    if d.value >= 0 {
      r = mk_let(k, d.name, t, abstract_fvars(k, d.value, prefix), r)
    } else if is_pi {
      r = mk_pi(k, d.name, t, r, BDefault)
    } else {
      r = mk_lam(k, d.name, t, r, BDefault)
    }
  }
  r
}

fn mk_pi_fvars(k : K, xs : Array[Expr], e : Expr) -> Expr {
  mk_binding(k, true, xs, e)
}

fn mk_lambda_fvars(k : K, xs : Array[Expr], e : Expr) -> Expr {
  mk_binding(k, false, xs, e)
}

// ---- well-known names ------------------------------------------------------------------

struct Names {
  nat : Name
  nat_zero : Name
  nat_succ : Name
  nat_add : Name
  nat_sub : Name
  nat_mul : Name
  nat_pow : Name
  nat_gcd : Name
  nat_mod : Name
  nat_div : Name
  nat_beq : Name
  nat_ble : Name
  nat_land : Name
  nat_lor : Name
  nat_xor : Name
  nat_shl : Name
  nat_shr : Name
  nat_log2 : Name
  bool_ : Name
  bool_true : Name
  bool_false : Name
  string : Name
  string_of_list : Name
  char : Name
  char_of_nat : Name
  list_nil : Name
  list_cons : Name
  eq : Name
  quot : Name
  quot_mk : Name
  quot_lift : Name
  quot_ind : Name
  eager_reduce : Name
  opt_param : Name
  auto_param : Name
  out_param : Name
  semi_out_param : Name
}

fn Names::new() -> Names {
  {
  nat: name_of_string("Nat"),
  nat_zero: name_of_string("Nat.zero"),
  nat_succ: name_of_string("Nat.succ"),
  nat_add: name_of_string("Nat.add"),
  nat_sub: name_of_string("Nat.sub"),
  nat_mul: name_of_string("Nat.mul"),
  nat_pow: name_of_string("Nat.pow"),
  nat_gcd: name_of_string("Nat.gcd"),
  nat_mod: name_of_string("Nat.mod"),
  nat_div: name_of_string("Nat.div"),
  nat_beq: name_of_string("Nat.beq"),
  nat_ble: name_of_string("Nat.ble"),
  nat_land: name_of_string("Nat.land"),
  nat_lor: name_of_string("Nat.lor"),
  nat_xor: name_of_string("Nat.xor"),
  nat_shl: name_of_string("Nat.shiftLeft"),
  nat_shr: name_of_string("Nat.shiftRight"),
  nat_log2: name_of_string("Nat.log2"),
  bool_: name_of_string("Bool"),
  bool_true: name_of_string("Bool.true"),
  bool_false: name_of_string("Bool.false"),
  string: name_of_string("String"),
  string_of_list: name_of_string("String.ofList"),
  char: name_of_string("Char"),
  char_of_nat: name_of_string("Char.ofNat"),
  list_nil: name_of_string("List.nil"),
  list_cons: name_of_string("List.cons"),
  eq: name_of_string("Eq"),
  quot: name_of_string("Quot"),
  quot_mk: name_of_string("Quot.mk"),
  quot_lift: name_of_string("Quot.lift"),
  quot_ind: name_of_string("Quot.ind"),
  eager_reduce: name_of_string("eagerReduce"),
    opt_param: name_of_string("optParam"),
    auto_param: name_of_string("autoParam"),
    out_param: name_of_string("outParam"),
    semi_out_param: name_of_string("semiOutParam"),
  }
}
