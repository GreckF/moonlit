// Expressions, hash-consed in a global k.arena.
//
// An `Expr` is the index of a node in the k.arena. Nodes are interned modulo
// binder names and binder info, so two expressions are alpha-equivalent iff
// they are the same index: equality and the caches of the type checker are
// O(1), which Lean gets from pointer equality. Every node caches its loose
// bound variable range (the least `n` such that all loose bound variables
// are `< n`) and whether it contains free variables or level parameters.

typealias Int as Expr

enum BinderInfo {
  BDefault
  BImplicit
  BStrictImplicit
  BInstImplicit
}

// The shape of a node, for matching.
enum View {
  VBVar(Int)
  VFVar(Int)
  VSort(Level)
  VConst(Name, List[Level])
  VApp(Expr, Expr)
  VLam(Name, Expr, Expr, BinderInfo)
  VPi(Name, Expr, Expr, BinderInfo)
  VLet(Name, Expr, Expr, Expr)
  VNatLit(Nat)
  VStrLit(String)
  VProj(Name, Int, Expr)
}

const K_BVAR : Int = 0
const K_FVAR : Int = 1
const K_SORT : Int = 2
const K_CONST : Int = 3
const K_APP : Int = 4
const K_LAM : Int = 5
const K_PI : Int = 6
const K_LET : Int = 7
const K_NAT : Int = 8
const K_STR : Int = 9
const K_PROJ : Int = 10

// The interning key of a node: its kind, up to three integer fields, and a
// payload for the non-integer parts (levels, names, literals).
enum Payload {
  PNone
  PLevel(Level)
  PConst(Name, List[Level])
  PNat(Nat)
  PStr(String)
  PName(Name)
}

fn payload_eq(a : Payload, b : Payload) -> Bool {
  match (a, b) {
    (PNone, PNone) => true
    (PLevel(x), PLevel(y)) => x.level_eq(y)
    (PConst(n1, l1), PConst(n2, l2)) => n1 == n2 && level_list_eq(l1, l2)
    (PNat(x), PNat(y)) => x == y
    (PStr(x), PStr(y)) => x == y
    (PName(x), PName(y)) => x == y
    _ => false
  }
}

// nonzero for every payload but `PNone`
fn payload_hash(p : Payload) -> Int {
  (match p {
    PNone => return 0
    PLevel(l) => l.hash_of()
    PConst(n, ls) => combine_hash(n.hash_of(), level_list_hash(ls))
    PNat(x) => x.to_bigint().hash()
    PStr(s) => s.hash()
    PName(n) => n.hash_of()
  }) | 1
}

fn mix_hash(h : Int) -> Int {
  let x = (h ^ (h >> 16)) * 0x45d9f3b
  x ^ (x >> 16)
}

fn node_hash(kind : Int, a : Int, b : Int, c : Int, ph : Int) -> Int {
  mix_hash(combine_hash(combine_hash(combine_hash(combine_hash(kind, a), b), c), ph))
}

struct Arena {
  kinds : Array[Int]
  fa : Array[Int]
  fb : Array[Int]
  fc : Array[Int]
  // binder name, binder info (as an Int) and payload of each node
  names : Array[Name]
  infos : Array[Int]
  payloads : Array[Payload]
  hashes : Array[Int]
  // loose bvar range << 2 | has level param << 1 | has fvar
  metas : Array[Int]
  // interned more than once: worth memoizing in traversals
  shared : Array[Bool]
  // the interning table: open addressing over node ids; -1 free, -2 deleted
  mut slots : Array[Int]
  // the number of live nodes: the arrays above may be longer (reused after
  // a collection, see `arena_collect`)
  mut len : Int
  // nodes freed by collections so far
  mut freed : Int
}

fn Arena::new() -> Arena {
  {
    kinds: Array::new(),
    fa: Array::new(),
    fb: Array::new(),
    fc: Array::new(),
    names: Array::new(),
    infos: Array::new(),
    payloads: Array::new(),
    hashes: Array::new(),
    metas: Array::new(),
    shared: Array::new(),
    slots: Array::make(1024, -1),
    len: 0,
    freed: 0,
  }
}

fn arena_size(k : K) -> Int {
  k.arena.len
}

// A table twice as large (when needed), without the deleted slots.
fn arena_grow(k : K) -> Unit {
  let a = k.arena
  let mut size = a.slots.length()
  while a.len * 2 >= size {
    size = size * 2
  }
  let slots = Array::make(size, -1)
  let mask = size - 1
  for id = 0; id < a.len; id = id + 1 {
    let mut i = a.hashes[id] & mask
    while slots[i] >= 0 {
      i = (i + 1) & mask
    }
    slots[i] = id
  }
  a.slots = slots
}

fn[T] put_at(xs : Array[T], i : Int, x : T) -> Unit {
  if i < xs.length() {
    xs[i] = x
  } else {
    xs.push(x)
  }
}

// The node with these fields, created if needed. `p` is compared only for
// the kinds that have a payload.
fn intern(
  k : K,
  kind : Int,
  fa : Int,
  fb : Int,
  fc : Int,
  p : Payload,
  ph : Int,
  name : Name,
  info : Int,
  meta : Int,
) -> Expr {
  let a = k.arena
  let h = node_hash(kind, fa, fb, fc, ph)
  let mask = a.slots.length() - 1
  let mut i = h & mask
  let mut free = -1
  while true {
    let id = a.slots[i]
    if id == -1 {
      break
    }
    if id == -2 {
      if free < 0 {
        free = i
      }
    } else if a.hashes[id] == h && a.kinds[id] == kind && a.fa[id] == fa && a.fb[id] == fb &&
      a.fc[id] == fc && (ph == 0 || payload_eq(a.payloads[id], p)) {
      a.shared[id] = true
      return id
    }
    i = (i + 1) & mask
  }
  if free >= 0 {
    i = free
  }
  let id = a.len
  put_at(a.kinds, id, kind)
  put_at(a.fa, id, fa)
  put_at(a.fb, id, fb)
  put_at(a.fc, id, fc)
  put_at(a.names, id, name)
  put_at(a.infos, id, info)
  put_at(a.payloads, id, p)
  put_at(a.hashes, id, h)
  put_at(a.metas, id, meta)
  put_at(a.shared, id, false)
  a.len = id + 1
  a.slots[i] = id
  if a.len * 2 >= a.slots.length() {
    arena_grow(k)
  }
  id
}

// Drop the nodes `mark ..` after copying the ones reachable from `root`;
// the copy of `root`. Whoever holds node ids must not hold any `>= mark`
// but `root` (the type checker's caches are purged by the caller).
fn arena_collect(k : K, mark : Int, root : Expr) -> Expr {
  let a = k.arena
  // the nodes `>= mark` reachable from `root`, children first
  let order : Array[Int] = Array::new()
  let seen : HashMap[Int, Int] = HashMap::new()
  collect_go(k, mark, root, order, seen)
  let n = order.length()
  let kinds = Array::make(n, 0)
  let fas = Array::make(n, 0)
  let fbs = Array::make(n, 0)
  let fcs = Array::make(n, 0)
  let names : Array[Name] = Array::make(n, Anon)
  let infos = Array::make(n, 0)
  let payloads : Array[Payload] = Array::make(n, PNone)
  let metas = Array::make(n, 0)
  for j = 0; j < n; j = j + 1 {
    let id = order[j]
    kinds[j] = a.kinds[id]
    fas[j] = a.fa[id]
    fbs[j] = a.fb[id]
    fcs[j] = a.fc[id]
    names[j] = a.names[id]
    infos[j] = a.infos[id]
    payloads[j] = a.payloads[id]
    metas[j] = a.metas[id]
  }
  // delete the dropped nodes from the table
  let mask = a.slots.length() - 1
  for id = mark; id < a.len; id = id + 1 {
    let mut i = a.hashes[id] & mask
    while a.slots[i] != id {
      i = (i + 1) & mask
    }
    a.slots[i] = -2
  }
  a.freed = a.freed + (a.len - mark) - n
  a.len = mark
  // re-create the copies, children first
  let fresh : HashMap[Int, Int] = HashMap::new()
  let relink = (x : Int, kd : Int, field : Int) => {
    // the fields of bvars, fvars and proj indices are not node ids
    if x < mark || kd == K_BVAR || kd == K_FVAR || (kd == K_PROJ && field == 1) {
      x
    } else {
      match fresh.get(x) {
        Some(y) => y
        None => x
      }
    }
  }
  for j = 0; j < n; j = j + 1 {
    let kd = kinds[j]
    let x = if kd == K_APP || kd == K_LAM || kd == K_PI || kd == K_LET || kd == K_PROJ {
      relink(fas[j], kd, 0)
    } else {
      fas[j]
    }
    let y = if kd == K_APP || kd == K_LAM || kd == K_PI || kd == K_LET {
      relink(fbs[j], kd, 1)
    } else {
      fbs[j]
    }
    let z = if kd == K_LET { relink(fcs[j], kd, 2) } else { fcs[j] }
    let p = payloads[j]
    let id = intern(k, kd, x, y, z, p, payload_hash(p), names[j], infos[j], metas[j])
    fresh.set(order[j], id)
  }
  if root < mark {
    root
  } else {
    match fresh.get(root) {
      Some(r) => r
      None => root
    }
  }
}

fn collect_go(k : K, mark : Int, e : Expr, order : Array[Int], seen : HashMap[Int, Int]) -> Unit {
  if e < mark || seen.contains(e) {
    return
  }
  seen.set(e, 0)
  let a = k.arena
  let kd = a.kinds[e]
  if kd == K_APP || kd == K_LAM || kd == K_PI {
    collect_go(k, mark, a.fa[e], order, seen)
    collect_go(k, mark, a.fb[e], order, seen)
  } else if kd == K_LET {
    collect_go(k, mark, a.fa[e], order, seen)
    collect_go(k, mark, a.fb[e], order, seen)
    collect_go(k, mark, a.fc[e], order, seen)
  } else if kd == K_PROJ {
    collect_go(k, mark, a.fa[e], order, seen)
  }
  order.push(e)
}

// ---- cached data -------------------------------------------------------------------

fn kind_of(k : K, e : Expr) -> Int {
  k.arena.kinds[e]
}

fn expr_hash(k : K, e : Expr) -> Int {
  k.arena.hashes[e]
}

fn loose_bvar_range(k : K, e : Expr) -> Int {
  k.arena.metas[e] >> 2
}

fn has_loose_bvars(k : K, e : Expr) -> Bool {
  k.arena.metas[e] >= 4
}

fn has_fvar(k : K, e : Expr) -> Bool {
  (k.arena.metas[e] & 1) != 0
}

fn has_lparam(k : K, e : Expr) -> Bool {
  (k.arena.metas[e] & 2) != 0
}

fn max_int(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

fn mk_meta(lbr : Int, lp : Bool, fv : Bool) -> Int {
  (lbr << 2) | (if lp { 2 } else { 0 }) | (if fv { 1 } else { 0 })
}

// the flags of two children, and their range under `bind` extra binders of the second
fn meta2(k : K, x : Expr, y : Expr, bind : Int) -> Int {
  let mx = k.arena.metas[x]
  let my = k.arena.metas[y]
  let ry = max_int((my >> 2) - bind, 0)
  (max_int(mx >> 2, ry) << 2) | ((mx | my) & 3)
}

// ---- constructors ----------------------------------------------------------------

fn info_to_int(bi : BinderInfo) -> Int {
  match bi {
    BDefault => 0
    BImplicit => 1
    BStrictImplicit => 2
    BInstImplicit => 3
  }
}

fn int_to_info(i : Int) -> BinderInfo {
  if i == 1 {
    BImplicit
  } else if i == 2 {
    BStrictImplicit
  } else if i == 3 {
    BInstImplicit
  } else {
    BDefault
  }
}

fn mk_bvar(k : K, i : Int) -> Expr {
  intern(k, K_BVAR, i, 0, 0, PNone, 0, Anon, 0, mk_meta(i + 1, false, false))
}

fn mk_fvar(k : K, id : Int) -> Expr {
  intern(k, K_FVAR, id, 0, 0, PNone, 0, Anon, 0, mk_meta(0, false, true))
}

fn mk_sort(k : K, l : Level) -> Expr {
  let p = PLevel(l)
  intern(k, K_SORT, 0, 0, 0, p, payload_hash(p), Anon, 0, mk_meta(0, l.has_param(), false))
}

fn levels_have_param(k : K, ls : List[Level]) -> Bool {
  match ls {
    Nil => false
    Cons(l, rest) => l.has_param() || levels_have_param(k, rest)
  }
}

fn mk_const(k : K, n : Name, ls : List[Level]) -> Expr {
  let p = PConst(n, ls)
  intern(k, K_CONST, 0, 0, 0, p, payload_hash(p), Anon, 0, mk_meta(0, levels_have_param(k, ls), false))
}

fn mk_app(k : K, f : Expr, a : Expr) -> Expr {
  intern(k, K_APP, f, a, 0, PNone, 0, Anon, 0, meta2(k, f, a, 0))
}

fn mk_lam(k : K, n : Name, t : Expr, b : Expr, bi : BinderInfo) -> Expr {
  intern(k, K_LAM, t, b, 0, PNone, 0, n, info_to_int(bi), meta2(k, t, b, 1))
}

fn mk_pi(k : K, n : Name, t : Expr, b : Expr, bi : BinderInfo) -> Expr {
  intern(k, K_PI, t, b, 0, PNone, 0, n, info_to_int(bi), meta2(k, t, b, 1))
}

fn mk_let(k : K, n : Name, t : Expr, v : Expr, b : Expr) -> Expr {
  let mt = meta2(k, t, v, 0)
  let mb = k.arena.metas[b]
  let rb = max_int((mb >> 2) - 1, 0)
  let m = (max_int(mt >> 2, rb) << 2) | ((mt | mb) & 3)
  intern(k, K_LET, t, v, b, PNone, 0, n, 0, m)
}

fn mk_nat_lit(k : K, n : Nat) -> Expr {
  let p = PNat(n)
  intern(k, K_NAT, 0, 0, 0, p, payload_hash(p), Anon, 0, 0)
}

fn mk_str_lit(k : K, s : String) -> Expr {
  let p = PStr(s)
  intern(k, K_STR, 0, 0, 0, p, payload_hash(p), Anon, 0, 0)
}

fn mk_proj(k : K, s : Name, i : Int, e : Expr) -> Expr {
  let p = PName(s)
  intern(k, K_PROJ, e, i, 0, p, payload_hash(p), Anon, 0, k.arena.metas[e])
}

// ---- views and accessors -----------------------------------------------------------

fn view(k : K, e : Expr) -> View {
  let kd = k.arena.kinds[e]
  if kd == K_BVAR {
    VBVar(k.arena.fa[e])
  } else if kd == K_FVAR {
    VFVar(k.arena.fa[e])
  } else if kd == K_SORT {
    match k.arena.payloads[e] {
      PLevel(l) => VSort(l)
      _ => abort("bad sort node")
    }
  } else if kd == K_CONST {
    match k.arena.payloads[e] {
      PConst(n, ls) => VConst(n, ls)
      _ => abort("bad const node")
    }
  } else if kd == K_APP {
    VApp(k.arena.fa[e], k.arena.fb[e])
  } else if kd == K_LAM {
    VLam(k.arena.names[e], k.arena.fa[e], k.arena.fb[e], int_to_info(k.arena.infos[e]))
  } else if kd == K_PI {
    VPi(k.arena.names[e], k.arena.fa[e], k.arena.fb[e], int_to_info(k.arena.infos[e]))
  } else if kd == K_LET {
    VLet(k.arena.names[e], k.arena.fa[e], k.arena.fb[e], k.arena.fc[e])
  } else if kd == K_NAT {
    match k.arena.payloads[e] {
      PNat(n) => VNatLit(n)
      _ => abort("bad nat node")
    }
  } else if kd == K_STR {
    match k.arena.payloads[e] {
      PStr(s) => VStrLit(s)
      _ => abort("bad str node")
    }
  } else {
    match k.arena.payloads[e] {
      PName(n) => VProj(n, k.arena.fb[e], k.arena.fa[e])
      _ => abort("bad proj node")
    }
  }
}

fn is_app(k : K, e : Expr) -> Bool {
  k.arena.kinds[e] == K_APP
}

fn is_lam(k : K, e : Expr) -> Bool {
  k.arena.kinds[e] == K_LAM
}

fn is_pi(k : K, e : Expr) -> Bool {
  k.arena.kinds[e] == K_PI
}

fn is_sort(k : K, e : Expr) -> Bool {
  k.arena.kinds[e] == K_SORT
}

// function and argument of an application
fn app_fn(k : K, e : Expr) -> Expr {
  k.arena.fa[e]
}

fn app_arg(k : K, e : Expr) -> Expr {
  k.arena.fb[e]
}

// domain and body of a binder (lambda, pi)
fn binding_domain(k : K, e : Expr) -> Expr {
  k.arena.fa[e]
}

fn binding_body(k : K, e : Expr) -> Expr {
  k.arena.fb[e]
}

fn binding_name(k : K, e : Expr) -> Name {
  k.arena.names[e]
}

fn binding_info(k : K, e : Expr) -> BinderInfo {
  int_to_info(k.arena.infos[e])
}

fn sort_level(k : K, e : Expr) -> Level {
  match k.arena.payloads[e] {
    PLevel(l) => l
    _ => Zero
  }
}

fn get_app_fn(k : K, e : Expr) -> Expr {
  let mut f = e
  while k.arena.kinds[f] == K_APP {
    f = k.arena.fa[f]
  }
  f
}

fn get_app_num_args(k : K, e : Expr) -> Int {
  let mut f = e
  let mut n = 0
  while k.arena.kinds[f] == K_APP {
    f = k.arena.fa[f]
    n = n + 1
  }
  n
}

// The arguments of an application spine, in order.
fn get_app_args(k : K, e : Expr) -> Array[Expr] {
  let n = get_app_num_args(k, e)
  let out = Array::make(n, 0)
  let mut f = e
  let mut i = n - 1
  while k.arena.kinds[f] == K_APP {
    out[i] = k.arena.fb[f]
    f = k.arena.fa[f]
    i = i - 1
  }
  out
}

fn mk_app_n(k : K, f : Expr, args : Array[Expr]) -> Expr {
  let mut r = f
  for a in args {
    r = mk_app(k, r, a)
  }
  r
}

fn mk_app_range(k : K, f : Expr, args : Array[Expr], start : Int, end : Int) -> Expr {
  let mut r = f
  for i = start; i < end; i = i + 1 {
    r = mk_app(k, r, args[i])
  }
  r
}

fn const_name(k : K, e : Expr) -> Name? {
  match k.arena.payloads[e] {
    PConst(n, _) => if k.arena.kinds[e] == K_CONST { Some(n) } else { None }
    _ => None
  }
}

fn const_levels(k : K, e : Expr) -> List[Level] {
  match k.arena.payloads[e] {
    PConst(_, ls) => ls
    _ => Nil
  }
}

fn is_const_of(k : K, e : Expr, n : Name) -> Bool {
  match const_name(k, e) {
    Some(m) => m == n
    None => false
  }
}

// ---- substitution ------------------------------------------------------------------------

// Memo tables for traversals of the DAG, keyed by (node, binder depth):
// open addressing, allocated on first use. Only shared nodes are memoized.
struct Memo {
  mut keys : Array[Int]
  mut offs : Array[Int]
  mut vals : Array[Int]
  mut count : Int
}

fn Memo::new() -> Memo {
  { keys: [], offs: [], vals: [], count: 0 }
}

fn Memo::get(self : Memo, e : Int, off : Int) -> Int {
  let n = self.keys.length()
  if n == 0 {
    return -1
  }
  let mask = n - 1
  let mut i = mix_hash(combine_hash(e, off)) & mask
  while self.keys[i] >= 0 {
    if self.keys[i] == e && self.offs[i] == off {
      return self.vals[i]
    }
    i = (i + 1) & mask
  }
  -1
}

fn Memo::put_raw(self : Memo, e : Int, off : Int, v : Int) -> Unit {
  let mask = self.keys.length() - 1
  let mut i = mix_hash(combine_hash(e, off)) & mask
  while self.keys[i] >= 0 {
    if self.keys[i] == e && self.offs[i] == off {
      self.vals[i] = v
      return
    }
    i = (i + 1) & mask
  }
  self.keys[i] = e
  self.offs[i] = off
  self.vals[i] = v
  self.count = self.count + 1
}

fn Memo::set(self : Memo, e : Int, off : Int, v : Int) -> Unit {
  if (self.count + 1) * 2 >= self.keys.length() {
    let ok = self.keys
    let oo = self.offs
    let ov = self.vals
    let size = if ok.length() == 0 { 64 } else { ok.length() * 2 }
    self.keys = Array::make(size, -1)
    self.offs = Array::make(size, 0)
    self.vals = Array::make(size, 0)
    self.count = 0
    for i = 0; i < ok.length(); i = i + 1 {
      if ok[i] >= 0 {
        self.put_raw(ok[i], oo[i], ov[i])
      }
    }
  }
  self.put_raw(e, off, v)
}

// `e` with new children (of the same kind); `e` itself when nothing changed.
fn update2(k : K, e : Expr, x : Expr, y : Expr) -> Expr {
  let a = k.arena
  if x == a.fa[e] && y == a.fb[e] {
    return e
  }
  let kd = a.kinds[e]
  if kd == K_APP {
    mk_app(k, x, y)
  } else if kd == K_LAM {
    intern(k, K_LAM, x, y, 0, PNone, 0, a.names[e], a.infos[e], meta2(k, x, y, 1))
  } else {
    intern(k, K_PI, x, y, 0, PNone, 0, a.names[e], a.infos[e], meta2(k, x, y, 1))
  }
}

fn update_let(k : K, e : Expr, t : Expr, v : Expr, b : Expr) -> Expr {
  let a = k.arena
  if t == a.fa[e] && v == a.fb[e] && b == a.fc[e] {
    e
  } else {
    mk_let(k, a.names[e], t, v, b)
  }
}

fn update_proj(k : K, e : Expr, x : Expr) -> Expr {
  let a = k.arena
  if x == a.fa[e] {
    e
  } else {
    match a.payloads[e] {
      PName(sn) => mk_proj(k, sn, a.fb[e], x)
      _ => e
    }
  }
}

// Lift loose bvars `>= s` by `n`.
fn lift_loose_bvars(k : K, e : Expr, s : Int, n : Int) -> Expr {
  if n == 0 || loose_bvar_range(k, e) <= s {
    e
  } else {
    lift_go(k, e, s, n, Memo::new())
  }
}

fn lift_go(k : K, e : Expr, s : Int, n : Int, m : Memo) -> Expr {
  if loose_bvar_range(k, e) <= s {
    return e
  }
  let shared = k.arena.shared[e]
  if shared {
    let r = m.get(e, s)
    if r >= 0 {
      return r
    }
  }
  let a = k.arena
  let kd = a.kinds[e]
  let r = if kd == K_BVAR {
    let i = a.fa[e]
    if i >= s { mk_bvar(k, i + n) } else { e }
  } else if kd == K_APP {
    update2(k, e, lift_go(k, a.fa[e], s, n, m), lift_go(k, a.fb[e], s, n, m))
  } else if kd == K_LAM || kd == K_PI {
    update2(k, e, lift_go(k, a.fa[e], s, n, m), lift_go(k, a.fb[e], s + 1, n, m))
  } else if kd == K_LET {
    update_let(k, e, lift_go(k, a.fa[e], s, n, m), lift_go(k, a.fb[e], s, n, m), lift_go(k, a.fc[e], s + 1, n, m))
  } else if kd == K_PROJ {
    update_proj(k, e, lift_go(k, a.fa[e], s, n, m))
  } else {
    e
  }
  if shared {
    m.set(e, s, r)
  }
  r
}

// Replace the loose bvars `0 .. subst.length()-1` by `subst[len-1-i]` (the
// substitution lists the binders outermost first, as in `instantiateRev`),
// and lower the other loose bvars by the length.
fn instantiate_rev(k : K, e : Expr, subst : Array[Expr]) -> Expr {
  if subst.length() == 0 || not(has_loose_bvars(k, e)) {
    e
  } else {
    inst_go(k, e, 0, subst, Memo::new())
  }
}

fn inst_go(k : K, e : Expr, off : Int, subst : Array[Expr], m : Memo) -> Expr {
  if loose_bvar_range(k, e) <= off {
    return e
  }
  let shared = k.arena.shared[e]
  if shared {
    let r = m.get(e, off)
    if r >= 0 {
      return r
    }
  }
  let n = subst.length()
  let a = k.arena
  let kd = a.kinds[e]
  let r = if kd == K_BVAR {
    let i = a.fa[e]
    if i < off {
      e
    } else if i - off < n {
      lift_loose_bvars(k, subst[n - 1 - (i - off)], 0, off)
    } else {
      mk_bvar(k, i - n)
    }
  } else if kd == K_APP {
    update2(k, e, inst_go(k, a.fa[e], off, subst, m), inst_go(k, a.fb[e], off, subst, m))
  } else if kd == K_LAM || kd == K_PI {
    update2(k, e, inst_go(k, a.fa[e], off, subst, m), inst_go(k, a.fb[e], off + 1, subst, m))
  } else if kd == K_LET {
    update_let(
      k,
      e,
      inst_go(k, a.fa[e], off, subst, m),
      inst_go(k, a.fb[e], off, subst, m),
      inst_go(k, a.fc[e], off + 1, subst, m),
    )
  } else if kd == K_PROJ {
    update_proj(k, e, inst_go(k, a.fa[e], off, subst, m))
  } else {
    e
  }
  if shared {
    m.set(e, off, r)
  }
  r
}

fn instantiate1(k : K, e : Expr, v : Expr) -> Expr {
  instantiate_rev(k, e, [v])
}

// Replace the free variables `fvars[i]` by bvars: the last one becomes
// `bvar 0` (so that `instantiate_rev(k, abstract_fvars(k, e, xs), xs) == e`).
fn abstract_fvars(k : K, e : Expr, fvars : Array[Int]) -> Expr {
  if fvars.length() == 0 || not(has_fvar(k, e)) {
    e
  } else {
    abs_go(k, e, 0, fvars, Memo::new())
  }
}

fn abs_go(k : K, e : Expr, off : Int, fvars : Array[Int], m : Memo) -> Expr {
  if not(has_fvar(k, e)) {
    return e
  }
  let shared = k.arena.shared[e]
  if shared {
    let r = m.get(e, off)
    if r >= 0 {
      return r
    }
  }
  let n = fvars.length()
  let a = k.arena
  let kd = a.kinds[e]
  let r = if kd == K_FVAR {
    let id = a.fa[e]
    let mut res = e
    for i = 0; i < n; i = i + 1 {
      if fvars[i] == id {
        res = mk_bvar(k, off + n - 1 - i)
      }
    }
    res
  } else if kd == K_APP {
    update2(k, e, abs_go(k, a.fa[e], off, fvars, m), abs_go(k, a.fb[e], off, fvars, m))
  } else if kd == K_LAM || kd == K_PI {
    update2(k, e, abs_go(k, a.fa[e], off, fvars, m), abs_go(k, a.fb[e], off + 1, fvars, m))
  } else if kd == K_LET {
    update_let(
      k,
      e,
      abs_go(k, a.fa[e], off, fvars, m),
      abs_go(k, a.fb[e], off, fvars, m),
      abs_go(k, a.fc[e], off + 1, fvars, m),
    )
  } else if kd == K_PROJ {
    update_proj(k, e, abs_go(k, a.fa[e], off, fvars, m))
  } else {
    e
  }
  if shared {
    m.set(e, off, r)
  }
  r
}

// Substitute universe level parameters.
fn instantiate_lparams(k : K, e : Expr, ps : List[Name], us : List[Level]) -> Expr {
  match ps {
    Nil => e
    _ => if not(has_lparam(k, e)) { e } else { ilp_go(k, e, ps, us, HashMap::new()) }
  }
}

fn ilp_go(k : K, e : Expr, ps : List[Name], us : List[Level], m : HashMap[Int, Expr]) -> Expr {
  if not(has_lparam(k, e)) {
    return e
  }
  match m.get(e) {
    Some(r) => return r
    None => ()
  }
  let r = match view(k, e) {
    VSort(l) => mk_sort(k, l.instantiate(ps, us))
    VConst(n, ls) => mk_const(k, n, ls.map(l => l.instantiate(ps, us)))
    VApp(f, a) => mk_app(k, ilp_go(k, f, ps, us, m), ilp_go(k, a, ps, us, m))
    VLam(nm, t, b, bi) => mk_lam(k, nm, ilp_go(k, t, ps, us, m), ilp_go(k, b, ps, us, m), bi)
    VPi(nm, t, b, bi) => mk_pi(k, nm, ilp_go(k, t, ps, us, m), ilp_go(k, b, ps, us, m), bi)
    VLet(nm, t, v, b) => mk_let(k, nm, ilp_go(k, t, ps, us, m), ilp_go(k, v, ps, us, m), ilp_go(k, b, ps, us, m))
    VProj(sn, i, x) => mk_proj(k, sn, i, ilp_go(k, x, ps, us, m))
    _ => e
  }
  m.set(e, r)
  r
}

// Does `e` mention the free variable `id`?
fn has_fvar_id(k : K, e : Expr, id : Int) -> Bool {
  hfi_go(k, e, id, HashMap::new())
}

fn hfi_go(k : K, e : Expr, id : Int, seen : HashMap[Int, Bool]) -> Bool {
  if not(has_fvar(k, e)) {
    return false
  }
  match seen.get(e) {
    Some(r) => return r
    None => ()
  }
  let r = match view(k, e) {
    VFVar(i) => i == id
    VApp(f, a) => hfi_go(k, f, id, seen) || hfi_go(k, a, id, seen)
    VLam(_, t, b, _) | VPi(_, t, b, _) => hfi_go(k, t, id, seen) || hfi_go(k, b, id, seen)
    VLet(_, t, v, b) => hfi_go(k, t, id, seen) || hfi_go(k, v, id, seen) || hfi_go(k, b, id, seen)
    VProj(_, _, x) => hfi_go(k, x, id, seen)
    _ => false
  }
  seen.set(e, r)
  r
}

// Does any constant of `e` satisfy `p`?
fn find_const(k : K, e : Expr, p : (Name) -> Bool) -> Name? {
  fc_go(k, e, p, HashMap::new())
}

fn fc_go(k : K, e : Expr, p : (Name) -> Bool, seen : HashMap[Int, Bool]) -> Name? {
  if seen.contains(e) {
    return None
  }
  seen.set(e, true)
  match view(k, e) {
    VConst(n, _) => if p(n) { Some(n) } else { None }
    VApp(f, a) =>
      match fc_go(k, f, p, seen) {
        Some(n) => Some(n)
        None => fc_go(k, a, p, seen)
      }
    VLam(_, t, b, _) | VPi(_, t, b, _) =>
      match fc_go(k, t, p, seen) {
        Some(n) => Some(n)
        None => fc_go(k, b, p, seen)
      }
    VLet(_, t, v, b) =>
      match fc_go(k, t, p, seen) {
        Some(n) => Some(n)
        None =>
          match fc_go(k, v, p, seen) {
            Some(n) => Some(n)
            None => fc_go(k, b, p, seen)
          }
      }
    VProj(_, _, x) => fc_go(k, x, p, seen)
    _ => None
  }
}

// ---- printing (for error messages) ------------------------------------------------------

fn expr_to_string(k : K, e : Expr, depth : Int) -> String {
  if depth <= 0 {
    return "…"
  }
  let d = depth - 1
  match view(k, e) {
    VBVar(i) => "#" + i.to_string()
    VFVar(i) => "_fv" + i.to_string()
    VSort(l) => "Sort " + l.to_string()
    VConst(n, _) => n.to_string()
    VApp(f, a) => "(" + expr_to_string(k, f, d) + " " + expr_to_string(k, a, d) + ")"
    VLam(n, t, b, _) => "(fun " + n.to_string() + " : " + expr_to_string(k, t, d) + " => " + expr_to_string(k, b, d) + ")"
    VPi(n, t, b, _) => "((" + n.to_string() + " : " + expr_to_string(k, t, d) + ") -> " + expr_to_string(k, b, d) + ")"
    VLet(n, t, v, b) =>
      "(let " + n.to_string() + " : " + expr_to_string(k, t, d) + " := " + expr_to_string(k, v, d) + "; " + expr_to_string(k, b, d) + ")"
    VNatLit(n) => n.to_string()
    VStrLit(s) => "\"" + s + "\""
    VProj(s, i, x) => expr_to_string(k, x, d) + "." + s.to_string() + "." + i.to_string()
  }
}

fn show_expr(k : K, e : Expr) -> String {
  expr_to_string(k, e, 12)
}
