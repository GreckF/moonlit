// Universe levels. Their semantics and the decision procedure for `<=`
// (`level_leq`), proved sound, are in `level_proof.mbtpp`.

enum Level {
  Zero
  Succ(Level)
  Max(Level, Level)
  IMax(Level, Level)
  Param(Name)
}

fn Level::level_eq(self : Level, other : Level) -> Bool {
  match (self, other) {
    (Zero, Zero) => true
    (Succ(a), Succ(b)) => a.level_eq(b)
    (Max(a1, b1), Max(a2, b2)) => a1.level_eq(a2) && b1.level_eq(b2)
    (IMax(a1, b1), IMax(a2, b2)) => a1.level_eq(a2) && b1.level_eq(b2)
    (Param(n1), Param(n2)) => n1 == n2
    _ => false
  }
}

impl Eq for Level with op_equal(a, b) { a.level_eq(b) }

fn Level::hash_of(self : Level) -> Int {
  match self {
    Zero => 7
    Succ(l) => combine_hash(l.hash_of(), 11)
    Max(a, b) => combine_hash(combine_hash(a.hash_of(), b.hash_of()), 13)
    IMax(a, b) => combine_hash(combine_hash(a.hash_of(), b.hash_of()), 17)
    Param(n) => combine_hash(n.hash_of(), 19)
  }
}

impl Hash for Level with hash(self) { self.hash_of() }

impl Show for Level with to_string(self) {
  match self {
    Zero => "0"
    Succ(l) => "(" + l.to_string() + "+1)"
    Max(a, b) => "(max " + a.to_string() + " " + b.to_string() + ")"
    IMax(a, b) => "(imax " + a.to_string() + " " + b.to_string() + ")"
    Param(n) => n.to_string()
  }
}

fn level_list_hash(ls : List[Level]) -> Int {
  match ls {
    Nil => 3
    Cons(l, rest) => combine_hash(l.hash_of(), level_list_hash(rest))
  }
}

fn level_list_eq(a : List[Level], b : List[Level]) -> Bool {
  match (a, b) {
    (Nil, Nil) => true
    (Cons(x, xs), Cons(y, ys)) => x.level_eq(y) && level_list_eq(xs, ys)
    _ => false
  }
}

fn Level::has_param(self : Level) -> Bool {
  match self {
    Zero => false
    Succ(l) => l.has_param()
    Max(a, b) | IMax(a, b) => a.has_param() || b.has_param()
    Param(_) => true
  }
}

fn name_mem(n : Name, ns : List[Name]) -> Bool {
  match ns {
    Nil => false
    Cons(m, rest) => m == n || name_mem(n, rest)
  }
}

// A parameter of `l` that is not among `ps`.
fn Level::undef_param(self : Level, ps : List[Name]) -> Name? {
  match self {
    Zero => None
    Succ(l) => l.undef_param(ps)
    Max(a, b) | IMax(a, b) =>
      match a.undef_param(ps) {
        Some(n) => Some(n)
        None => b.undef_param(ps)
      }
    Param(n) => if name_mem(n, ps) { None } else { Some(n) }
  }
}

// `instantiate`, `mk_max`, `mk_imax`, `is_never_zero` and `is_always_zero`
// are in `level_proof.mbtpp`, with proofs.

fn level_equiv(a : Level, b : Level) -> Bool {
  a.level_eq(b) || (level_leq(a, b) && level_leq(b, a))
}

fn level_list_equiv(a : List[Level], b : List[Level]) -> Bool {
  match (a, b) {
    (Nil, Nil) => true
    (Cons(x, xs), Cons(y, ys)) => level_equiv(x, y) && level_list_equiv(xs, ys)
    _ => false
  }
}
