// ---- natural numbers: order, max, imax ------------------------------------------

enum NatLe : (Nat, Nat) -> Prop {
  LeZ[n : Nat] : NatLe(Z, n)
  LeS[m : Nat, n : Nat](NatLe(m, n)) : NatLe(S(m), S(n))
}

fn nmax(a : Nat, b : Nat) -> Nat {
  match (a, b) {
    (Z, _) => b
    (S(_), Z) => a
    (S(x), S(y)) => S(nmax(x, y))
  }
}

fn nimax(a : Nat, b : Nat) -> Nat {
  match b {
    Z => Z
    S(_) => nmax(a, b)
  }
}

// `x + k`, by recursion on `k`
fn addk(x : Nat, k : Nat) -> Nat {
  match k {
    Z => x
    S(j) => S(addk(x, j))
  }
}

lemma le_refl(n : Nat) -> NatLe(n, n) {
  match n {
    Z => LeZ
    S(m) => LeS(le_refl(m))
  }
}

lemma le_trans[a : Nat, b : Nat, c : Nat](p : NatLe(a, b), q : NatLe(b, c)) -> NatLe(a, c) {
  match (p, q) {
    (LeZ, _) => LeZ
    (LeS(p2), LeS(q2)) => LeS(le_trans(p2, q2))
  }
}

// rewriting the sides of an inequality
lemma le_rw_r[a : Nat, b : Nat, c : Nat](e : b === c, p : NatLe(a, b)) -> NatLe(a, c) {
  match e {
    Refl => p
  }
}

lemma le_rw_l[a : Nat, b : Nat, c : Nat](e : a === b, p : NatLe(a, c)) -> NatLe(b, c) {
  match e {
    Refl => p
  }
}

lemma le_of_eq[a : Nat, b : Nat](e : a === b) -> NatLe(a, b) {
  match e {
    Refl => le_refl(a)
  }
}

lemma le_max_l(a : Nat, b : Nat) -> NatLe(a, nmax(a, b)) {
  match (a, b) {
    (Z, _) => LeZ
    (S(x), Z) => le_refl(S(x))
    (S(x), S(y)) => LeS(le_max_l(x, y))
  }
}

lemma le_max_r(a : Nat, b : Nat) -> NatLe(b, nmax(a, b)) {
  match (a, b) {
    (Z, _) => le_refl(b)
    (S(_), Z) => LeZ
    (S(x), S(y)) => LeS(le_max_r(x, y))
  }
}

lemma max_le[a : Nat, b : Nat, c : Nat](p : NatLe(a, c), q : NatLe(b, c)) -> NatLe(nmax(a, b), c) {
  match (p, q) {
    (LeZ, _) => q
    (LeS(p2), LeZ) => LeS(p2)
    (LeS(p2), LeS(q2)) => LeS(max_le(p2, q2))
  }
}

lemma max_mono[a : Nat, b : Nat, c : Nat, d : Nat](p : NatLe(a, c), q : NatLe(b, d)) -> NatLe(nmax(a, b), nmax(c, d)) {
  max_le(le_trans(p, le_max_l(c, d)), le_trans(q, le_max_r(c, d)))
}

lemma k_le_addk(x : Nat, k : Nat) -> NatLe(k, addk(x, k)) {
  match k {
    Z => LeZ
    S(j) => LeS(k_le_addk(x, j))
  }
}

lemma addk_mono_l[x : Nat, y : Nat](p : NatLe(x, y), k : Nat) -> NatLe(addk(x, k), addk(y, k)) {
  match k {
    Z => p
    S(j) => LeS(addk_mono_l(p, j))
  }
}

lemma addk_mono_r[j : Nat, k : Nat](x : Nat, p : NatLe(j, k)) -> NatLe(addk(x, j), addk(x, k)) {
  match p {
    LeZ => addk_ge(x, k)
    LeS(q) => LeS(addk_mono_r(x, q))
  }
}

lemma addk_ge(x : Nat, k : Nat) -> NatLe(x, addk(x, k)) {
  match k {
    Z => le_refl(x)
    S(j) => le_trans(addk_ge(x, j), le_succ(addk(x, j)))
  }
}

lemma le_succ(n : Nat) -> NatLe(n, S(n)) {
  match n {
    Z => LeZ
    S(m) => LeS(le_succ(m))
  }
}

// `(x + 1) + k = x + (k + 1)`
lemma addk_succ(x : Nat, k : Nat) -> addk(S(x), k) === addk(x, S(k)) {
  match k {
    Z => Refl
    S(j) => Id::cong(S, addk_succ(x, j))
  }
}

// `max(x, y) + k = max(x + k, y + k)`
lemma addk_max(x : Nat, y : Nat, k : Nat) -> addk(nmax(x, y), k) === nmax(addk(x, k), addk(y, k)) {
  match k {
    Z => Refl
    S(j) => {
      let ih = addk_max(x, y, j)
      // max(S a, S b) = S (max a b)
      Id::trans(Id::cong(S, ih), max_succ(addk(x, j), addk(y, j)))
    }
  }
}

lemma max_succ(a : Nat, b : Nat) -> S(nmax(a, b)) === nmax(S(a), S(b)) {
  Refl
}

lemma max_z_r(a : Nat) -> nmax(a, Z) === a {
  match a {
    Z => Refl
    S(_) => Refl
  }
}
// ---- levels with numbered parameters (lean4lean's VLevel) ---------------------------

enum VLevel {
  VZero
  VSucc(VLevel)
  VMax(VLevel, VLevel)
  VIMax(VLevel, VLevel)
  VParam(Nat)
}

fn ev(l : VLevel, rho : (Nat) -> Nat) -> Nat {
  match l {
    VZero => Z
    VSucc(u) => S(ev(u, rho))
    VMax(a, b) => nmax(ev(a, rho), ev(b, rho))
    VIMax(a, b) => nimax(ev(a, rho), ev(b, rho))
    VParam(p) => rho(p)
  }
}

// `a <= b` under every assignment of the parameters
enum VLevelLE : (VLevel, VLevel) -> Prop {
  MkVLE[a : VLevel, b : VLevel](h : (rho : (Nat) -> Nat) -> NatLe(ev(a, rho), ev(b, rho))) : VLevelLE(a, b)
}

// ---- zero, nonzero or unknown ----------------------------------------------------

enum Zness : (VLevel) -> Type {
  KZero[v : VLevel](h : (rho : (Nat) -> Nat) -> ev(v, rho) === Z) : Zness(v)
  KNz[v : VLevel](h : (rho : (Nat) -> Nat) -> NatLe(S(Z), ev(v, rho))) : Zness(v)
  KUnknown[v : VLevel] : Zness(v)
}

lemma nmax_zz[x : Nat, y : Nat](p : x === Z, q : y === Z) -> nmax(x, y) === Z {
  match p {
    Refl =>
      match q {
        Refl => Refl
      }
  }
}

lemma nimax_z(x : Nat, y : Nat, q : y === Z) -> nimax(x, y) === Z {
  match q {
    Refl => Refl
  }
}

lemma nimax_nz(x : Nat, y : Nat, q : NatLe(S(Z), y)) -> nimax(x, y) === nmax(x, y) {
  match q {
    LeS(_) => Refl
  }
}

fn zness(v : VLevel) -> Zness(v) {
  match v {
    VZero => KZero(_ => Refl)
    VSucc(u) => KNz(rho => LeS(LeZ))
    VParam(_) => KUnknown
    VMax(a, b) =>
      match zness(a) {
        KNz(ha) => KNz(rho => le_trans(ha(rho), le_max_l(ev(a, rho), ev(b, rho))))
        KZero(ha) =>
          match zness(b) {
            KNz(hb) => KNz(rho => le_trans(hb(rho), le_max_r(ev(a, rho), ev(b, rho))))
            KZero(hb) => KZero(rho => nmax_zz(ha(rho), hb(rho)))
            KUnknown => KUnknown
          }
        KUnknown =>
          match zness(b) {
            KNz(hb) => KNz(rho => le_trans(hb(rho), le_max_r(ev(a, rho), ev(b, rho))))
            _ => KUnknown
          }
      }
    VIMax(a, b) =>
      match zness(b) {
        KZero(hb) => KZero(rho => nimax_z(ev(a, rho), ev(b, rho), hb(rho)))
        KNz(hb) =>
          KNz(rho => {
            let e = nimax_nz(ev(a, rho), ev(b, rho), hb(rho))
            le_rw_r(Id::sym(e), le_trans(hb(rho), le_max_r(ev(a, rho), ev(b, rho))))
          })
        KUnknown => KUnknown
      }
  }
}

// ---- flat forms: max(c, p + k, ...) ------------------------------------------

enum Ent {
  EConst(Nat)
  EVar(Nat, Nat)
}

fn ent_ev(e : Ent, rho : (Nat) -> Nat) -> Nat {
  match e {
    EConst(c) => c
    EVar(p, k) => addk(rho(p), k)
  }
}

fn fev(es : List[Ent], rho : (Nat) -> Nat) -> Nat {
  match es {
    Nil => Z
    Cons(e, r) => nmax(ent_ev(e, rho), fev(r, rho))
  }
}

lemma addk_z(k : Nat) -> addk(Z, k) === k {
  match k {
    Z => Refl
    S(j) => Id::cong(S, addk_z(j))
  }
}

// max(x, max(y, z)) <= max(max(x, y), z)
lemma max_assoc_le(x : Nat, y : Nat, z : Nat) -> NatLe(nmax(x, nmax(y, z)), nmax(nmax(x, y), z)) {
  let xy = nmax(x, y)
  max_le(
    le_trans(le_max_l(x, y), le_max_l(xy, z)),
    max_le(le_trans(le_max_r(x, y), le_max_l(xy, z)), le_max_r(xy, z)),
  )
}

// `r` is a flat form of `l + k` joined with `acc`
enum Flat : (VLevel, Nat, List[Ent]) -> Type {
  MkFlat[l : VLevel, k : Nat, acc : List[Ent]](
    r : List[Ent],
    up_l : (rho : (Nat) -> Nat) -> NatLe(addk(ev(l, rho), k), fev(r, rho)),
    up_acc : (rho : (Nat) -> Nat) -> NatLe(fev(acc, rho), fev(r, rho)),
    low : (rho : (Nat) -> Nat) -> NatLe(fev(r, rho), nmax(addk(ev(l, rho), k), fev(acc, rho))),
  ) : Flat(l, k, acc)
}

// a flat form for `l1` is one for `l2` when they have the same value
fn[l1 : VLevel, k : Nat, acc : List[Ent]] flat_rw(
  f : Flat(l1, k, acc),
  l2 : VLevel,
  e : (rho : (Nat) -> Nat) -> ev(l1, rho) === ev(l2, rho),
) -> Flat(l2, k, acc) {
  match f {
    MkFlat(r, up_l, up_acc, low) =>
      MkFlat[l2, k, acc](
        r,
        rho => le_rw_l(Id::cong(x => addk(x, k), e(rho)), up_l(rho)),
        up_acc,
        rho => le_rw_r(Id::cong(x => nmax(addk(x, k), fev(acc, rho)), e(rho)), low(rho)),
      )
  }
}

fn flat_const(k : Nat, acc : List[Ent]) -> Flat(VZero, k, acc) {
  MkFlat[VZero, k, acc](
    Cons(EConst(k), acc),
    rho => le_trans(le_of_eq(addk_z(k)), le_max_l(k, fev(acc, rho))),
    rho => le_max_r(k, fev(acc, rho)),
    rho => max_mono(le_of_eq(Id::sym(addk_z(k))), le_refl(fev(acc, rho))),
  )
}

fn flatten(l : VLevel, k : Nat, acc : List[Ent]) -> Flat(l, k, acc)? {
  match l {
    VZero => Some(flat_const(k, acc))
    VParam(p) =>
      Some(
        MkFlat[l, k, acc](
          Cons(EVar(p, k), acc),
          rho => le_max_l(addk(rho(p), k), fev(acc, rho)),
          rho => le_max_r(addk(rho(p), k), fev(acc, rho)),
          rho => le_refl(nmax(addk(rho(p), k), fev(acc, rho))),
        ),
      )
    VSucc(u) =>
      match flatten(u, S(k), acc) {
        Some(MkFlat(r, up_l, up_acc, low)) =>
          Some(
            MkFlat[l, k, acc](
              r,
              rho => le_rw_l(Id::sym(addk_succ(ev(u, rho), k)), up_l(rho)),
              up_acc,
              rho => le_rw_r(Id::cong(x => nmax(x, fev(acc, rho)), Id::sym(addk_succ(ev(u, rho), k))), low(rho)),
            ),
          )
        None => None
      }
    VMax(a, b) => flatten_max(a, b, k, acc)
    VIMax(a, b) =>
      match zness(b) {
        KZero(hb) => Some(flat_rw(flat_const(k, acc), l, rho => Id::sym(nimax_z(ev(a, rho), ev(b, rho), hb(rho)))))
        KNz(hb) =>
          match flatten_max(a, b, k, acc) {
            Some(f) => Some(flat_rw(f, l, rho => Id::sym(nimax_nz(ev(a, rho), ev(b, rho), hb(rho)))))
            None => None
          }
        KUnknown => None
      }
  }
}

fn flatten_max(a : VLevel, b : VLevel, k : Nat, acc : List[Ent]) -> Flat(VMax(a, b), k, acc)? {
  match flatten(b, k, acc) {
    None => None
    Some(MkFlat(r1, ub_l, ub_acc, lb)) =>
      match flatten(a, k, r1) {
        None => None
        Some(MkFlat(r, ua_l, ua_acc, la)) =>
          Some(
            MkFlat[VMax(a, b), k, acc](
              r,
              rho => {
                let ea = addk(ev(a, rho), k)
                let eb = addk(ev(b, rho), k)
                le_rw_l(
                  Id::sym(addk_max(ev(a, rho), ev(b, rho), k)),
                  max_le(ua_l(rho), le_trans(ub_l(rho), ua_acc(rho))),
                )
              },
              rho => le_trans(ub_acc(rho), ua_acc(rho)),
              rho => {
                let ea = addk(ev(a, rho), k)
                let eb = addk(ev(b, rho), k)
                let fa = fev(acc, rho)
                // fev r <= max(ea, fev r1) <= max(ea, max(eb, fa)) <= max(max(ea, eb), fa)
                let s1 = le_trans(la(rho), max_mono(le_refl(ea), lb(rho)))
                let s2 = le_trans(s1, max_assoc_le(ea, eb, fa))
                le_rw_r(Id::cong(x => nmax(x, fa), Id::sym(addk_max(ev(a, rho), ev(b, rho), k))), s2)
              },
            ),
          )
      }
  }
}

fn main {
  match flatten(VMax(VParam(0), VSucc(VZero)), Z, Nil) {
    Some(MkFlat(r, _, _, _)) => println(r.length())
    None => println("none")
  }
}
