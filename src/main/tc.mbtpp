// The type checker: type inference, weak head normalization and definitional
// equality, following lean4lean's `TypeChecker.lean`.

struct Tc {
  mut infer_i : HashMap[Int, Expr]
  mut infer_c : HashMap[Int, Expr]
  mut whnf_core_c : HashMap[Int, AnyRed]
  mut whnf_c : HashMap[Int, AnyRed]
  mut failure : HashMap[(Int, Int), Bool]
  // union-find over expressions known to be definitionally equal
  mut uf : HashMap[Int, AnyEq]
  // values of constants (`c.{ls}` as a node) with the levels substituted, and
  // recursor rules (`rec.{ls}` node, rule index): these depend only on the
  // environment, so they are kept across declarations
  unfold_c : HashMap[Int, Expr]
  rule_c : HashMap[(Int, Int), Expr]
  mut lparams : List[Name]
  mut safety : Safety
  mut eager : Bool
  // counters for profiling: see `stat_names`
  stats : Array[Int]
  // every cache write since the declaration started: (cache, key, key2),
  // to purge the entries that mention collected nodes
  log_c : Array[Int]
  log_a : Array[Int]
  log_b : Array[Int]
  mut log_len : Int
}

const C_INFER_I : Int = 0
const C_INFER_C : Int = 1
const C_WHNF_CORE : Int = 2
const C_WHNF : Int = 3
const C_FAILURE : Int = 4
const C_UF : Int = 5
const C_UNFOLD : Int = 6
const C_RULE : Int = 7

// a region collects when it created more nodes than this
const GC_THRESHOLD : Int = 200000

fn tc_log(k : K, c : Int, x : Int, y : Int) -> Unit {
  let t = k.tc
  put_at(t.log_c, t.log_len, c)
  put_at(t.log_a, t.log_len, x)
  put_at(t.log_b, t.log_len, y)
  t.log_len = t.log_len + 1
}

fn cache_of(k : K, c : Int) -> HashMap[Int, Expr] {
  if c == C_INFER_I {
    k.tc.infer_i
  } else if c == C_INFER_C {
    k.tc.infer_c
  } else {
    k.tc.unfold_c
  }
}

// Remove the cache entries written since `lmark` that mention nodes `>= mark`.
fn tc_purge(k : K, mark : Int, lmark : Int) -> Unit {
  let t = k.tc
  let mut out = lmark
  for i = lmark; i < t.log_len; i = i + 1 {
    let c = t.log_c[i]
    let x = t.log_a[i]
    let y = t.log_b[i]
    let keep = if c == C_FAILURE {
      if x >= mark || y >= mark {
        t.failure.remove((x, y))
        false
      } else {
        true
      }
    } else if c == C_UF {
      match t.uf.get(x) {
        Some(a) =>
          if x >= mark || a.dst() >= mark {
            t.uf.remove(x)
            false
          } else {
            true
          }
        None => false
      }
    } else if c == C_WHNF_CORE || c == C_WHNF {
      let m = if c == C_WHNF { t.whnf_c } else { t.whnf_core_c }
      match m.get(x) {
        Some(a) =>
          if x >= mark || a.dst() >= mark {
            m.remove(x)
            false
          } else {
            true
          }
        None => false
      }
    } else if c == C_RULE {
      match t.rule_c.get((x, y)) {
        Some(v) =>
          if x >= mark || y >= mark || v >= mark {
            t.rule_c.remove((x, y))
            false
          } else {
            true
          }
        None => false
      }
    } else {
      let m = cache_of(k, c)
      match m.get(x) {
        Some(v) =>
          if x >= mark || v >= mark {
            m.remove(x)
            false
          } else {
            true
          }
        None => false
      }
    }
    if keep {
      t.log_c[out] = c
      t.log_a[out] = x
      t.log_b[out] = y
      out = out + 1
    }
  }
  t.log_len = out
}

// Collect the nodes created since `mark`, keeping those of `root`.
fn gc_region(k : K, mark : Int, lmark : Int, root : Expr) -> Expr {
  tc_purge(k, mark, lmark)
  arena_collect(k, mark, root)
}

const ST_WHNF : Int = 0
const ST_WHNF_HIT : Int = 1
const ST_DEFEQ : Int = 2
const ST_IOTA : Int = 3
const ST_DELTA : Int = 4
const ST_INFER : Int = 5
const ST_INFER_HIT : Int = 6
const ST_BETA : Int = 7

fn stat_names() -> Array[String] {
  ["whnf", "whnf_hit", "defeq", "iota", "delta", "infer", "infer_hit", "beta"]
}

fn bump(k : K, i : Int) -> Unit {
  k.tc.stats[i] = k.tc.stats[i] + 1
}

fn Tc::new() -> Tc {
  {
  infer_i: HashMap::new(),
  infer_c: HashMap::new(),
  whnf_core_c: HashMap::new(),
  whnf_c: HashMap::new(),
  failure: HashMap::new(),
  uf: HashMap::new(),
  unfold_c: HashMap::new(),
  rule_c: HashMap::new(),
  lparams: Nil,
  safety: SafeDecl,
  eager: false,
  stats: Array::make(8, 0),
  log_c: Array::new(),
  log_a: Array::new(),
  log_b: Array::new(),
  log_len: 0,
  }
}

fn tc_reset(k : K, lparams : List[Name], safety : Safety) -> Unit {
  k.tc.infer_i = HashMap::new()
  k.tc.infer_c = HashMap::new()
  k.tc.whnf_core_c = HashMap::new()
  k.tc.whnf_c = HashMap::new()
  k.tc.failure = HashMap::new()
  k.tc.uf = HashMap::new()
  k.tc.log_len = 0
  k.tc.lparams = lparams
  k.tc.safety = safety
  k.tc.eager = false
}

const WHNF_FUEL : Int = 1000000

const LAZY_FUEL : Int = 1000000

// the equivalence manager (union-find) is in `defeq.mbtpp`

// ---- basic helpers ---------------------------------------------------------------------

fn ensure_sort_core(k : K, e : Expr, s : Expr) -> Expr raise KernelError {
  if is_sort(k, e) {
    return e
  }
  let e2 = whnf(k, e)
  if is_sort(k, e2) {
    e2
  } else {
    kfail("type expected: " + show_expr(k, s))
  }
}

fn ensure_pi_core(k : K, e : Expr, s : Expr) -> Expr raise KernelError {
  if is_pi(k, e) {
    return e
  }
  let e2 = whnf(k, e)
  if is_pi(k, e2) {
    e2
  } else {
    kfail("function expected: " + show_expr(k, s))
  }
}

fn check_level(k : K, l : Level) -> Unit raise KernelError {
  match l.undef_param(k.tc.lparams) {
    Some(n) => kfail("undefined universe level parameter '\{n}'")
    None => ()
  }
}

fn infer_constant(k : K, e : Expr, n : Name, ls : List[Level], infer_only : Bool) -> Expr raise KernelError {
  let info = env_get(k, n)
  if info.num_lparams(k) != list_length(ls) {
    kfail("incorrect number of universe levels for '\{n}'")
  }
  if not(infer_only) {
    if info.is_unsafe(k) {
      match k.tc.safety {
        UnsafeDecl => ()
        _ => kfail("invalid declaration, it uses unsafe declaration '\{n}'")
      }
    }
    if info.is_partial(k) {
      match k.tc.safety {
        SafeDecl => kfail("invalid declaration, safe declaration must not contain partial declaration '\{n}'")
        _ => ()
      }
    }
    let mut cur = ls
    while cur is Cons(l, rest) {
      check_level(k, l)
      cur = rest
    }
  }
  ignore(e)
  instantiate_lparams(k, info.type, info.lparams, ls)
}

// `(fun x1 .. xn => b) a1 .. am` without substitution, when cheap.
fn cheap_beta_reduce(k : K, e : Expr) -> Expr {
  if not(is_app(k, e)) {
    return e
  }
  let f = get_app_fn(k, e)
  if not(is_lam(k, f)) {
    return e
  }
  let args = get_app_args(k, e)
  let mut i = 0
  let mut body = f
  while i < args.length() && is_lam(k, body) {
    body = binding_body(k, body)
    i = i + 1
  }
  if not(has_loose_bvars(k, body)) {
    mk_app_range(k, body, args, i, args.length())
  } else {
    match view(k, body) {
      VBVar(n) => mk_app_range(k, args[i - n - 1], args, i, args.length())
      _ => e
    }
  }
}

// ---- type inference ----------------------------------------------------------------------

fn infer_type(k : K, e : Expr) -> Expr raise KernelError {
  infer_type_core(k, e, true)
}

fn check_type(k : K, e : Expr) -> Expr raise KernelError {
  infer_type_core(k, e, false)
}

fn infer_type_core(k : K, e : Expr, infer_only : Bool) -> Expr raise KernelError {
  if has_loose_bvars(k, e) {
    kfail("type checker does not support loose bound variables")
  }
  let cache = if infer_only { k.tc.infer_i } else { k.tc.infer_c }
  bump(k, ST_INFER)
  match cache.get(e) {
    Some(r) => {
      bump(k, ST_INFER_HIT)
      return r
    }
    None => ()
  }
  let r = match view(k, e) {
    VNatLit(_) => {
      if not(infer_only) {
        ignore(env_get(k, k.names.nat))
      }
      mk_const(k, k.names.nat, Nil)
    }
    VStrLit(_) => {
      if not(infer_only) {
        ignore(env_get(k, k.names.char_of_nat))
        ignore(env_get(k, k.names.string_of_list))
      }
      mk_const(k, k.names.string, Nil)
    }
    VProj(s, idx, x) => infer_proj(k, e, s, idx, x, infer_type_core(k, x, infer_only))
    VFVar(id) => local_type(k, id)
    VBVar(_) => kfail("unexpected bound variable")
    VSort(l) => {
      if not(infer_only) {
        check_level(k, l)
      }
      mk_sort(k, Succ(l))
    }
    VConst(n, ls) => infer_constant(k, e, n, ls, infer_only)
    VLam(_, _, _, _) => infer_lambda(k, e, infer_only)
    VPi(_, _, _, _) => infer_pi(k, e, infer_only)
    VApp(f, a) =>
      if infer_only {
        infer_app(k, e)
      } else {
        let ftype = ensure_pi_core(k, infer_type_core(k, f, infer_only), e)
        let atype = infer_type_core(k, a, infer_only)
        let dtype = binding_domain(k, ftype)
        let ok = if get_app_num_args(k, a) == 2 && is_const_of(k, get_app_fn(k, a), k.names.eager_reduce) {
          let saved = k.tc.eager
          k.tc.eager = true
          let r = is_def_eq(k, dtype, atype)
          k.tc.eager = saved
          r
        } else {
          is_def_eq(k, dtype, atype)
        }
        if not(ok) {
          kfail("application type mismatch: " + show_expr(k, e))
        }
        instantiate1(k, binding_body(k, ftype), a)
      }
    VLet(_, _, _, _) => infer_let(k, e, infer_only)
  }
  cache.set(e, r)
  tc_log(k, if infer_only { C_INFER_I } else { C_INFER_C }, e, 0)
  r
}

fn infer_lambda(k : K, e0 : Expr, infer_only : Bool) -> Expr raise KernelError {
  let fvars : Array[Expr] = Array::new()
  let mut e = e0
  while is_lam(k, e) {
    let d = instantiate_rev(k, binding_domain(k, e), fvars)
    if not(infer_only) {
      ignore(ensure_sort_core(k, infer_type_core(k, d, infer_only), d))
    }
    fvars.push(mk_local_decl(k, binding_name(k, e), d))
    e = binding_body(k, e)
  }
  let r = infer_type_core(k, instantiate_rev(k, e, fvars), infer_only)
  mk_pi_fvars(k, fvars, cheap_beta_reduce(k, r))
}

fn infer_pi(k : K, e0 : Expr, infer_only : Bool) -> Expr raise KernelError {
  let fvars : Array[Expr] = Array::new()
  let us : Array[Level] = Array::new()
  let mut e = e0
  while is_pi(k, e) {
    let d = instantiate_rev(k, binding_domain(k, e), fvars)
    let t1 = ensure_sort_core(k, infer_type_core(k, d, infer_only), d)
    us.push(sort_level(k, t1))
    fvars.push(mk_local_decl(k, binding_name(k, e), d))
    e = binding_body(k, e)
  }
  let body = instantiate_rev(k, e, fvars)
  let s = ensure_sort_core(k, infer_type_core(k, body, infer_only), body)
  let mut l = sort_level(k, s)
  for i = us.length() - 1; i >= 0; i = i - 1 {
    l = mk_imax(us[i], l)
  }
  mk_sort(k, l)
}

fn infer_app(k : K, e : Expr) -> Expr raise KernelError {
  let f = get_app_fn(k, e)
  let args = get_app_args(k, e)
  let mut ftype = infer_type_core(k, f, true)
  let mut j = 0
  for i = 0; i < args.length(); i = i + 1 {
    if is_pi(k, ftype) {
      ftype = binding_body(k, ftype)
    } else {
      ftype = instantiate_rev(k, ftype, args.slice(j, i))
      ftype = binding_body(k, ensure_pi_core(k, ftype, e))
      j = i
    }
  }
  instantiate_rev(k, ftype, args.slice(j, args.length()))
}

fn infer_let(k : K, e0 : Expr, infer_only : Bool) -> Expr raise KernelError {
  let fvars : Array[Expr] = Array::new()
  let mut e = e0
  while kind_of(k, e) == K_LET {
    match view(k, e) {
      VLet(n, t0, v0, b) => {
        let t = instantiate_rev(k, t0, fvars)
        let v = instantiate_rev(k, v0, fvars)
        if not(infer_only) {
          ignore(ensure_sort_core(k, infer_type_core(k, t, infer_only), t))
          let vt = infer_type_core(k, v, infer_only)
          if not(is_def_eq(k, vt, t)) {
            kfail("let type mismatch: " + n.to_string())
          }
        }
        fvars.push(mk_let_decl(k, n, t, v))
        e = b
      }
      _ => break
    }
  }
  let r = infer_type_core(k, instantiate_rev(k, e, fvars), infer_only)
  mk_pi_fvars(k, fvars, cheap_beta_reduce(k, r))
}

fn get_sort_level(k : K, e : Expr) -> Level raise KernelError {
  sort_level(k, ensure_sort_core(k, infer_type(k, e), e))
}

fn is_prop(k : K, e : Expr) -> Bool raise KernelError {
  get_sort_level(k, e).is_always_zero()
}

fn infer_proj(k : K, e : Expr, tname : Name, idx : Int, s : Expr, stype : Expr) -> Expr raise KernelError {
  let t = whnf(k, stype)
  let i_fn = get_app_fn(k, t)
  let args = get_app_args(k, t)
  let i_name = match const_name(k, i_fn) {
    Some(n) => n
    None => kfail("invalid projection: " + show_expr(k, e))
  }
  if i_name != tname {
    kfail("invalid projection: " + show_expr(k, e))
  }
  let ival = match env_find_induct(k, i_name) {
    Some(v) => v
    None => kfail("invalid projection: " + show_expr(k, e))
  }
  let c = match ival.ctors {
    Cons(c, Nil) => c
    _ => kfail("invalid projection: " + show_expr(k, e))
  }
  if args.length() != ival.nparams + ival.nindices {
    kfail("invalid projection: " + show_expr(k, e))
  }
  let cinfo = env_get(k, c)
  let mut r = instantiate_lparams(k, cinfo.type, cinfo.lparams, const_levels(k, i_fn))
  for i = 0; i < ival.nparams; i = i + 1 {
    let rw = whnf(k, r)
    if not(is_pi(k, rw)) {
      kfail("invalid projection: " + show_expr(k, e))
    }
    r = instantiate1(k, binding_body(k, rw), args[i])
  }
  let maybe_prop = not(get_sort_level(k, t).is_never_zero())
  for i = 0; i < idx; i = i + 1 {
    let rw = whnf(k, r)
    if not(is_pi(k, rw)) {
      kfail("invalid projection: " + show_expr(k, e))
    }
    let b = binding_body(k, rw)
    if has_loose_bvars(k, b) {
      // prop structures cannot have non-prop dependent fields
      if maybe_prop && not(is_prop(k, binding_domain(k, rw))) {
        kfail("invalid projection: " + show_expr(k, e))
      }
      r = instantiate1(k, b, mk_proj(k, i_name, i, s))
    } else {
      r = b
    }
  }
  let rw = whnf(k, r)
  if not(is_pi(k, rw)) {
    kfail("invalid projection: " + show_expr(k, e))
  }
  let dom = binding_domain(k, rw)
  if maybe_prop && not(is_prop(k, dom)) {
    kfail("invalid projection: " + show_expr(k, e))
  }
  dom
}

// ---- weak head normalization ---------------------------------------------------------------

fn is_let_fvar(k : K, e : Expr) -> Bool {
  kind_of(k, e) == K_FVAR && k.lctx.decls[fvar_id(k, e)].value >= 0
}

fn whnf_core(k : K, e : Expr) -> Expr raise KernelError {
  whnf_core_pc(k, e, false).target()
}

fn whnf_core_p(k : K, e : Expr, cheap_proj : Bool) -> Expr raise KernelError {
  whnf_core_pc(k, e, cheap_proj).target()
}

lemma head_is_lam[k : K, e : Expr, f0 : Expr](ef0 : get_app_fn(k, e) === f0, h : is_lam(k, f0) === true) -> is_lam(k, get_app_fn(k, e)) === true {
  match ef0 {
    Refl => h
  }
}

// weak head normalization without unfolding definitions, with its derivation
fn whnf_core_pc(k : K, e : Expr, cheap_proj : Bool) -> RedTo(k, e) raise KernelError {
  let kd = kind_of(k, e)
  if kd == K_BVAR || kd == K_SORT || kd == K_PI || kd == K_CONST || kd == K_LAM || kd == K_NAT || kd == K_STR {
    return MkRedTo(e, RRefl)
  }
  if kd == K_FVAR && not(is_let_fvar(k, e)) {
    return MkRedTo(e, RRefl)
  }
  match k.tc.whnf_core_c.get(e) {
    Some(a) =>
      match any_red_get(k, e, a) {
        Some(r) => return r
        None => ()
      }
    None => ()
  }
  let res : RedTo(k, e) = if kd == K_FVAR {
    match inspect(view(k, e)) {
      MkSing(VFVar(id), ev) =>
        match inspect(local_value(k, id)) {
          MkSing(Some(v), elv) =>
            match whnf_core_pc(k, v, cheap_proj) {
              MkRedTo(r, p) => MkRedTo(r, RTrans(RLetVar(ev, elv), p))
            }
          MkSing(None, _) => MkRedTo(e, RRefl)
        }
      MkSing(_, _) => MkRedTo(e, RRefl)
    }
  } else if kd == K_APP {
    whnf_app_c(k, e, cheap_proj)
  } else if kd == K_LET {
    match inspect(view(k, e)) {
      MkSing(VLet(_, _, v, b), ev) =>
        match whnf_core_pc(k, instantiate1(k, b, v), cheap_proj) {
          MkRedTo(r, p) => MkRedTo(r, RTrans(RZeta(ev), p))
        }
      MkSing(_, _) => MkRedTo(e, RRefl)
    }
  } else {
    match inspect(view(k, e)) {
      MkSing(VProj(_, idx, s), ev) =>
        match reduce_proj_c(k, idx, s, cheap_proj) {
          Some(MkProjRes(_, ps, m, em)) =>
            match whnf_core_pc(k, m, cheap_proj) {
              MkRedTo(r, p) => MkRedTo(r, RTrans(RProj(ev, ps, em), p))
            }
          None => MkRedTo(e, RRefl)
        }
      MkSing(_, _) => MkRedTo(e, RRefl)
    }
  }
  if not(cheap_proj) {
    match res {
      MkRedTo(t, p) => {
        k.tc.whnf_core_c.set(e, MkAnyRed(k, e, t, p))
        tc_log(k, C_WHNF_CORE, e, 0)
      }
    }
  }
  res
}

// an application: reduce the head, then β or a recursor
fn whnf_app_c(k : K, e : Expr, cheap_proj : Bool) -> RedTo(k, e) raise KernelError {
  match inspect(get_app_fn(k, e)) {
    MkSing(f0, ef0) =>
      match whnf_core_pc(k, f0, cheap_proj) {
        MkRedTo(f, pf) =>
          match Int::deq(f, f0) {
            Yes(Refl) =>
              match reflect(is_lam(k, f0)) {
                IsTrue(h) => {
                  bump(k, ST_BETA)
                  match whnf_core_pc(k, beta_spine(k, e), cheap_proj) {
                    MkRedTo(r, p) => MkRedTo(r, RTrans(RBeta(head_is_lam(ef0, h)), p))
                  }
                }
                IsFalse(_) =>
                  match reduce_recursor_c(k, e) {
                    Some(MkRedTo(r1, p1)) =>
                      match whnf_core_pc(k, r1, cheap_proj) {
                        MkRedTo(r, p) => MkRedTo(r, RTrans(p1, p))
                      }
                    None => MkRedTo(e, RRefl)
                  }
              }
            No(_) => {
              let pf2 : Red(k, get_app_fn(k, e), f) = red_rw_src(Id::sym(ef0), pf)
              match whnf_core_pc(k, mk_app_n(k, f, get_app_args(k, e)), cheap_proj) {
                MkRedTo(r, p) => MkRedTo(r, RTrans(RHead(pf2), p))
              }
            }
          }
      }
  }
}

fn reduce_proj_core(k : K, idx : Int, s0 : Expr) -> Expr? raise KernelError {
  let s = match view(k, s0) {
    VStrLit(str) => whnf(k, str_lit_to_ctor(k, str))
    _ => s0
  }
  let mk = get_app_fn(k, s)
  match const_name(k, mk) {
    Some(c) =>
      match env_find_ctor(k, c) {
        Some(cv) => {
          let args = get_app_args(k, s)
          let i = cv.nparams + idx
          if i < args.length() { Some(args[i]) } else { None }
        }
        None => None
      }
    None => None
  }
}

// a reduced projection: the structure `s` reduces to `c`, whose field `i` is `r`
enum ProjRes : (K, Int, Expr) -> Type {
  MkProjRes[k : K, i : Int, s : Expr](c : Expr, p : Red(k, s, c), r : Expr, e : proj_field(k, i, c) === Some(r)) : ProjRes(k, i, s)
}

fn reduce_proj_c(k : K, idx : Int, s : Expr, cheap_proj : Bool) -> ProjRes(k, idx, s)? raise KernelError {
  let c0 = if cheap_proj { whnf_core_pc(k, s, cheap_proj) } else { whnf_c(k, s) }
  let cr : RedTo(k, s) = match c0 {
    MkRedTo(c, p) =>
      match inspect(view(k, c)) {
        MkSing(VStrLit(str), ev) =>
          match whnf_c(k, str_lit_to_ctor(k, str)) {
            MkRedTo(c1, p1) => MkRedTo(c1, RTrans(p, RTrans(RStrLit(ev), p1)))
          }
        MkSing(_, _) => MkRedTo(c, p)
      }
  }
  match cr {
    MkRedTo(c, p) =>
      match inspect(proj_field(k, idx, c)) {
        MkSing(Some(r), er) => Some(MkProjRes(c, p, r, er))
        MkSing(None, _) => None
      }
  }
}


// The definition a constant head can be unfolded to.
fn is_delta(k : K, e : Expr) -> ConstInfo? {
  let f = get_app_fn(k, e)
  match view(k, f) {
    VConst(n, ls) =>
      match env_find(k, n) {
        Some(ci) =>
          match ci.delta_value(k) {
            Some(_) => if ci.num_lparams(k) == list_length(ls) { Some(ci) } else { None }
            None => None
          }
        None => None
      }
    _ => None
  }
}

fn unfold_definition_core(k : K, e : Expr) -> Expr? {
  match view(k, e) {
    VConst(_, ls) =>
      match is_delta(k, e) {
        Some(ci) =>
          match ci.delta_value(k) {
            Some(v) =>
              match k.tc.unfold_c.get(e) {
                Some(r) => Some(r)
                None => {
                  let r = instantiate_lparams(k, v, ci.lparams, ls)
                  k.tc.unfold_c.set(e, r)
                  tc_log(k, C_UNFOLD, e, 0)
                  Some(r)
                }
              }
            None => None
          }
        None => None
      }
    _ => None
  }
}

fn unfold_definition(k : K, e : Expr) -> Expr? {
  if is_app(k, e) {
    match unfold_definition_core(k, get_app_fn(k, e)) {
      Some(f) => Some(mk_app_n(k, f, get_app_args(k, e)))
      None => None
    }
  } else {
    unfold_definition_core(k, e)
  }
}

fn whnf(k : K, e : Expr) -> Expr raise KernelError {
  whnf_c(k, e).target()
}

// weak head normalization, with its derivation
fn whnf_c(k : K, e : Expr) -> RedTo(k, e) raise KernelError {
  let kd = kind_of(k, e)
  if kd == K_BVAR || kd == K_SORT || kd == K_PI || kd == K_NAT || kd == K_STR {
    return MkRedTo(e, RRefl)
  }
  if kd == K_FVAR && not(is_let_fvar(k, e)) {
    return MkRedTo(e, RRefl)
  }
  bump(k, ST_WHNF)
  match k.tc.whnf_c.get(e) {
    Some(a) =>
      match any_red_get(k, e, a) {
        Some(r) => {
          bump(k, ST_WHNF_HIT)
          return r
        }
        None => ()
      }
    None => ()
  }
  // a region: the nodes this call creates, but for the result, are garbage
  let mark = arena_size(k)
  let lmark = k.tc.log_len
  let mut cur : RedTo(k, e) = MkRedTo(e, RRefl)
  let mut fuel = WHNF_FUEL
  while true {
    if fuel <= 0 {
      kfail("deterministic timeout (whnf)")
    }
    fuel = fuel - 1
    if arena_size(k) - mark > GC_THRESHOLD {
      cur = match cur {
        MkRedTo(t, p) => MkRedTo(gc_region(k, mark, lmark, t), RTrans(p, RCopy))
      }
    }
    cur = match cur {
      MkRedTo(t, p) =>
        match whnf_core_pc(k, t, false) {
          MkRedTo(t2, p2) => MkRedTo(t2, RTrans(p, p2))
        }
    }
    let stop = match cur {
      MkRedTo(t, p) =>
        match reduce_nat_c(k, t) {
          Some(MkRedTo(t2, p2)) => {
            cur = MkRedTo(t2, RTrans(p, p2))
            true
          }
          None =>
            match inspect(unfold_definition(k, t)) {
              MkSing(Some(t2), ed) => {
                bump(k, ST_DELTA)
                cur = MkRedTo(t2, RTrans(p, RDelta(ed)))
                false
              }
              MkSing(None, _) => true
            }
        }
    }
    if stop {
      break
    }
  }
  if arena_size(k) - mark > GC_THRESHOLD {
    cur = match cur {
      MkRedTo(t, p) => MkRedTo(gc_region(k, mark, lmark, t), RTrans(p, RCopy))
    }
  }
  match cur {
    MkRedTo(t, p) => {
      k.tc.whnf_c.set(e, MkAnyRed(k, e, t, p))
      tc_log(k, C_WHNF, e, 0)
    }
  }
  cur
}

// ---- Nat and String literals ---------------------------------------------------------------

fn nat_lit_value(k : K, e : Expr) -> Nat? {
  match view(k, e) {
    VNatLit(n) => Some(n)
    VConst(n, Nil) => if n == k.names.nat_zero { Some(Z) } else { None }
    _ => None
  }
}

fn nat_lit_to_ctor(k : K, n : Nat) -> Expr {
  if n == Z {
    mk_const(k, k.names.nat_zero, Nil)
  } else {
    mk_app(k, mk_const(k, k.names.nat_succ, Nil), mk_nat_lit(k, n - 1))
  }
}

fn str_lit_to_ctor(k : K, s : String) -> Expr {
  let char = mk_const(k, k.names.char, Nil)
  let nil = mk_app(k, mk_const(k, k.names.list_nil, Cons(Zero, Nil)), char)
  let cons = mk_app(k, mk_const(k, k.names.list_cons, Cons(Zero, Nil)), char)
  let of_nat = mk_const(k, k.names.char_of_nat, Nil)
  let codes = string_code_points(k, s)
  let mut r = nil
  for i = codes.length() - 1; i >= 0; i = i - 1 {
    r = mk_app(k, mk_app(k, cons, mk_app(k, of_nat, mk_nat_lit(k, int_to_nat(codes[i])))), r)
  }
  mk_app(k, mk_const(k, k.names.string_of_list, Nil), r)
}

// The code points of a string (combining UTF-16 surrogate pairs).
fn string_code_points(k : K, s : String) -> Array[Int] {
  let out : Array[Int] = Array::new()
  let mut i = 0
  while i < s.length() {
    let c = s[i].to_int()
    if c >= 0xD800 && c < 0xDC00 && i + 1 < s.length() {
      let lo = s[i + 1].to_int()
      if lo >= 0xDC00 && lo < 0xE000 {
        out.push(0x10000 + (c - 0xD800) * 0x400 + (lo - 0xDC00))
        i = i + 2
        continue
      }
    }
    out.push(c)
    i = i + 1
  }
  out
}

fn mk_bool(k : K, b : Bool) -> Expr {
  mk_const(k, if b { k.names.bool_true } else { k.names.bool_false }, Nil)
}

// Literal arithmetic with Lean's conventions (truncated subtraction, division
// by zero is zero, remainder by zero is the dividend), which `Nat` follows.
fn nat_bin_op(k : K, f : Name, a : Nat, b : Nat) -> Expr? {
  let limit : Nat = 16777216
  if f == k.names.nat_add {
    Some(mk_nat_lit(k, a + b))
  } else if f == k.names.nat_sub {
    Some(mk_nat_lit(k, a - b))
  } else if f == k.names.nat_mul {
    Some(mk_nat_lit(k, a * b))
  } else if f == k.names.nat_pow {
    if b > limit { None } else { Some(mk_nat_lit(k, a.pow(b))) }
  } else if f == k.names.nat_gcd {
    Some(mk_nat_lit(k, a.gcd(b)))
  } else if f == k.names.nat_mod {
    Some(mk_nat_lit(k, a % b))
  } else if f == k.names.nat_div {
    Some(mk_nat_lit(k, a / b))
  } else if f == k.names.nat_beq {
    Some(mk_bool(k, a == b))
  } else if f == k.names.nat_ble {
    Some(mk_bool(k, a <= b))
  } else if f == k.names.nat_land {
    Some(mk_nat_lit(k, a & b))
  } else if f == k.names.nat_lor {
    Some(mk_nat_lit(k, a | b))
  } else if f == k.names.nat_xor {
    Some(mk_nat_lit(k, a ^ b))
  } else if f == k.names.nat_shl {
    if b > limit { None } else { Some(mk_nat_lit(k, a << b)) }
  } else if f == k.names.nat_shr {
    Some(mk_nat_lit(k, a >> b))
  } else {
    None
  }
}

fn is_nat_bin_op(k : K, f : Name) -> Bool {
  f == k.names.nat_add || f == k.names.nat_sub || f == k.names.nat_mul || f == k.names.nat_pow ||
  f == k.names.nat_gcd || f == k.names.nat_mod || f == k.names.nat_div || f == k.names.nat_beq ||
  f == k.names.nat_ble || f == k.names.nat_land || f == k.names.nat_lor || f == k.names.nat_xor ||
  f == k.names.nat_shl || f == k.names.nat_shr
}

fn reduce_nat(k : K, e : Expr) -> Expr? raise KernelError {
  match reduce_nat_c(k, e) {
    Some(r) => Some(r.target())
    None => None
  }
}

// `Nat.succ` and the binary operations of `Nat` on literals, with derivations
fn reduce_nat_c(k : K, e : Expr) -> RedTo(k, e)? raise KernelError {
  match inspect(view(k, e)) {
    MkSing(VApp(g, b), ev) =>
      match reflect(is_const_of(k, g, k.names.nat_succ)) {
        IsTrue(h) =>
          match whnf_c(k, b) {
            MkRedTo(lb, pb) =>
              match inspect(nat_lit_value(k, lb)) {
                MkSing(Some(v), elv) => Some(MkRedTo(mk_nat_lit(k, v + 1), RNatSucc(ev, h, pb, elv)))
                MkSing(None, _) => None
              }
          }
        IsFalse(_) =>
          match inspect(view(k, g)) {
            MkSing(VApp(f, a), eg) =>
              match inspect(view(k, f)) {
                MkSing(VConst(fname, _), ef) =>
                  if is_nat_bin_op(k, fname) {
                    match whnf_c(k, a) {
                      MkRedTo(la, pa) =>
                        match inspect(nat_lit_value(k, la)) {
                          MkSing(Some(va), ea) =>
                            match whnf_c(k, b) {
                              MkRedTo(lb, pb) =>
                                match inspect(nat_lit_value(k, lb)) {
                                  MkSing(Some(vb), eb) =>
                                    match inspect(nat_bin_op(k, fname, va, vb)) {
                                      MkSing(Some(r), er) => Some(MkRedTo(r, RNatBin(ev, eg, ef, pa, pb, ea, eb, er)))
                                      MkSing(None, _) => None
                                    }
                                  MkSing(None, _) => None
                                }
                            }
                          MkSing(None, _) => None
                        }
                    }
                  } else {
                    None
                  }
                MkSing(_, _) => None
              }
            MkSing(_, _) => None
          }
      }
    MkSing(_, _) => None
  }
}

// ---- definitional equality ---------------------------------------------------------------

// definitional equality is in `defeq.mbtpp`

fn is_nat_zero(k : K, t : Expr) -> Bool {
  match nat_lit_value(k, t) {
    Some(v) => v == Z
    None => false
  }
}

fn is_nat_succ_of(k : K, t : Expr) -> Expr? {
  match view(k, t) {
    VNatLit(n) => if n == Z { None } else { Some(mk_nat_lit(k, n - 1)) }
    VApp(f, a) => if is_const_of(k, f, k.names.nat_succ) { Some(a) } else { None }
    _ => None
  }
}

// ---- quotients ---------------------------------------------------------------------------

// the `Quot.mk` argument of `Quot.lift f h q ...` or `Quot.ind p q ...`
fn quot_major(k : K, e : Expr) -> Expr? {
  let f = get_app_fn(k, e)
  let pos = if is_const_of(k, f, k.names.quot_lift) {
    5
  } else if is_const_of(k, f, k.names.quot_ind) {
    4
  } else {
    return None
  }
  let args = get_app_args(k, e)
  if pos < args.length() { Some(args[pos]) } else { None }
}

// `Quot.lift f h (Quot.mk r a) ...` is `f a ...`, `Quot.ind p (Quot.mk r a) ...` is `p a ...`
fn quot_apply(k : K, e : Expr, mk : Expr) -> Expr? {
  let f = get_app_fn(k, e)
  let pos = if is_const_of(k, f, k.names.quot_lift) {
    5
  } else if is_const_of(k, f, k.names.quot_ind) {
    4
  } else {
    return None
  }
  let args = get_app_args(k, e)
  if pos >= args.length() || not(is_const_of(k, get_app_fn(k, mk), k.names.quot_mk) && get_app_num_args(k, mk) == 3) {
    return None
  }
  let r = mk_app(k, args[3], app_arg(k, mk))
  Some(mk_app_range(k, r, args, pos + 1, args.length()))
}

fn quot_reduce_c(k : K, e : Expr) -> RedTo(k, e)? raise KernelError {
  match inspect(quot_major(k, e)) {
    MkSing(Some(m), em) =>
      match whnf_c(k, m) {
        MkRedTo(mk, pm) =>
          match inspect(quot_apply(k, e, mk)) {
            MkSing(Some(r), er) => Some(MkRedTo(r, RQuot(em, pm, er)))
            MkSing(None, _) => None
          }
      }
    MkSing(None, _) => None
  }
}

// ---- inductive types ---------------------------------------------------------------------

fn rec_major_idx(k : K, rv : RecVal) -> Int {
  ignore(k)
  rv.nparams + rv.nmotives + rv.nminors + rv.nindices
}

fn rec_major_induct(k : K, ci : ConstInfo, rv : RecVal) -> Name {
  // the inductive type of the major premise: the head of its type
  let mut t = ci.type
  for i = 0; i < rec_major_idx(k, rv); i = i + 1 {
    t = binding_body(k, t)
  }
  match const_name(k, get_app_fn(k, binding_domain(k, t))) {
    Some(n) => n
    None => Anon
  }
}

// the recursor at the head of `e`
fn rec_info(k : K, e : Expr) -> (ConstInfo, RecVal)? {
  match const_name(k, get_app_fn(k, e)) {
    Some(n) =>
      match env_find(k, n) {
        Some(ci) =>
          match ci.kind {
            CRec(rv) => Some((ci, rv))
            _ => None
          }
        None => None
      }
    None => None
  }
}

// the major premise of a recursor application
fn rec_major(k : K, e : Expr) -> Expr? {
  match rec_info(k, e) {
    Some((_, rv)) => {
      let args = get_app_args(k, e)
      let i = rec_major_idx(k, rv)
      if i < args.length() { Some(args[i]) } else { None }
    }
    None => None
  }
}

fn mk_nullary_ctor(k : K, type_ : Expr, nparams : Int) -> Expr? {
  let d = get_app_fn(k, type_)
  match view(k, d) {
    VConst(dn, ls) =>
      match env_find_induct(k, dn) {
        Some(iv) =>
          match iv.ctors {
            Cons(c, _) => Some(mk_app_range(k, mk_const(k, c, ls), get_app_args(k, type_), 0, nparams))
            Nil => None
          }
        None => None
      }
    _ => None
  }
}

// the type is an inductive type whose recursor has K-like reduction
fn k_target_type(k : K, t : Expr) -> Bool {
  match const_name(k, get_app_fn(k, t)) {
    Some(i) =>
      match env_find(k, mk_rec_name(k, i)) {
        Some({ kind: CRec(rv), .. }) => rv.k
        _ => false
      }
    None => false
  }
}

// the type is a non-recursive structure
fn struct_type(k : K, t : Expr) -> Bool {
  match const_name(k, get_app_fn(k, t)) {
    Some(i) =>
      match env_find_induct(k, i) {
        Some(iv) => is_structure_like(k, i) && not(iv.is_rec)
        None => false
      }
    None => false
  }
}

fn sort_never_zero(k : K, s : Expr) -> Bool {
  is_sort(k, s) && sort_level(k, s).is_never_zero()
}

// K-like reduction: the major premise as the nullary constructor
fn to_ctor_when_k_c(k : K, major_induct : Name, np : Int, m : Expr) -> EqTo(k, m) raise KernelError {
  match inspect(infer_oracle(k, m)) {
    MkSing(Ok(ty), ei) =>
      match whnf_c(k, ty) {
        MkRedTo(tyn, pr) => {
          if not(is_const_of(k, get_app_fn(k, tyn), major_induct)) {
            return MkEqTo(m, DRefl)
          }
          match reflect(k_target_type(k, tyn)) {
            IsTrue(hk) =>
              match inspect(mk_nullary_ctor(k, tyn, np)) {
                MkSing(Some(c), ec) =>
                  match inspect(infer_oracle(k, c)) {
                    MkSing(Ok(cty), eci) =>
                      match is_def_eq_c(k, tyn, cty) {
                        Holds(q) => MkEqTo(c, DKLike(ei, pr, hk, ec, eci, q))
                        Fail => MkEqTo(m, DRefl)
                      }
                    MkSing(Err(err), _) => raise err
                  }
                MkSing(None, _) => MkEqTo(m, DRefl)
              }
            IsFalse(_) => MkEqTo(m, DRefl)
          }
        }
      }
    MkSing(Err(err), _) => raise err
  }
}

fn is_constructor_app(k : K, e : Expr) -> Bool {
  match const_name(k, get_app_fn(k, e)) {
    Some(n) =>
      match env_find_ctor(k, n) {
        Some(_) => true
        None => false
      }
    None => false
  }
}

fn expand_eta_struct(k : K, etype : Expr, e : Expr) -> Expr {
  let i = get_app_fn(k, etype)
  match view(k, i) {
    VConst(iname, ls) =>
      match env_find_induct(k, iname) {
        Some({ ctors: Cons(c, _), .. }) =>
          match env_find_ctor(k, c) {
            Some(cv) => {
              let mut r = mk_app_range(k, mk_const(k, c, ls), get_app_args(k, etype), 0, cv.nparams)
              for j = 0; j < cv.nfields; j = j + 1 {
                r = mk_app(k, r, mk_proj(k, iname, j, e))
              }
              r
            }
            None => e
          }
        _ => e
      }
    _ => e
  }
}

// structure η on the major premise: the constructor applied to its projections
fn to_ctor_when_struct_c(k : K, induct : Name, e : Expr) -> EqTo(k, e) raise KernelError {
  if not(is_structure_like(k, induct)) || is_constructor_app(k, e) {
    return MkEqTo(e, DRefl)
  }
  match env_find_induct(k, induct) {
    Some(iv) => if iv.is_rec { return MkEqTo(e, DRefl) }
    None => return MkEqTo(e, DRefl)
  }
  match inspect(infer_oracle(k, e)) {
    MkSing(Ok(ty), e1) =>
      match whnf_c(k, ty) {
        MkRedTo(tyn, pr) => {
          if not(is_const_of(k, get_app_fn(k, tyn), induct)) {
            return MkEqTo(e, DRefl)
          }
          match reflect(struct_type(k, tyn)) {
            IsTrue(hs) =>
              match inspect(infer_oracle(k, tyn)) {
                MkSing(Ok(sty), e2) =>
                  match whnf_c(k, sty) {
                    MkRedTo(styn, ps) =>
                      match reflect(sort_never_zero(k, styn)) {
                        IsTrue(hz) => MkEqTo(expand_eta_struct(k, tyn, e), DEtaExp(e1, pr, hs, e2, ps, hz))
                        IsFalse(_) => MkEqTo(e, DRefl)
                      }
                  }
                MkSing(Err(err), _) => raise err
              }
            IsFalse(_) => MkEqTo(e, DRefl)
          }
        }
      }
    MkSing(Err(err), _) => raise err
  }
}

fn get_rec_rule(k : K, rv : RecVal, major : Expr) -> RecRule? {
  match const_name(k, get_app_fn(k, major)) {
    Some(fname) => {
      let mut cur = rv.rules
      while cur is Cons(r, rest) {
        if r.ctor == fname {
          return Some(r)
        }
        cur = rest
      }
      None
    }
    None => None
  }
}

// the reduct of the recursor application `e` whose major premise is the
// constructor application `c`
fn iota_apply(k : K, e : Expr, c : Expr) -> Expr? {
  let (ci, rv) = match rec_info(k, e) {
    Some(r) => r
    None => return None
  }
  let f = get_app_fn(k, e)
  let ls = const_levels(k, f)
  let rec_args = get_app_args(k, e)
  let major_idx = rec_major_idx(k, rv)
  if major_idx >= rec_args.length() {
    return None
  }
  let rule = match get_rec_rule(k, rv, c) {
    Some(r) => r
    None => return None
  }
  let major_args = get_app_args(k, c)
  if rule.nfields > major_args.length() || list_length(ls) != ci.num_lparams(k) {
    return None
  }
  let mut rhs = match k.tc.rule_c.get((f, rule.rhs)) {
    Some(r) => r
    None => {
      let r = instantiate_lparams(k, rule.rhs, ci.lparams, ls)
      k.tc.rule_c.set((f, rule.rhs), r)
      tc_log(k, C_RULE, f, rule.rhs)
      r
    }
  }
  rhs = mk_app_range(k, rhs, rec_args, 0, rv.nparams + rv.nmotives + rv.nminors)
  rhs = mk_app_range(k, rhs, major_args, major_args.length() - rule.nfields, major_args.length())
  if major_idx + 1 < rec_args.length() {
    rhs = mk_app_range(k, rhs, rec_args, major_idx + 1, rec_args.length())
  }
  Some(rhs)
}

// ι-reduction: bring the major premise to a constructor application (K-like
// reduction, weak head normalization, literals, structure η), then apply the
// rule of the constructor
fn inductive_reduce_c(k : K, e : Expr) -> RedTo(k, e)? raise KernelError {
  match inspect(rec_major(k, e)) {
    MkSing(Some(m0), em) => {
      let (ci, rv) = match rec_info(k, e) {
        Some(r) => r
        None => return None
      }
      let major_induct = rec_major_induct(k, ci, rv)
      let k1 : EqTo(k, m0) = if rv.k {
        to_ctor_when_k_c(k, major_induct, rv.nparams, m0)
      } else {
        MkEqTo(m0, DRefl)
      }
      match k1 {
        MkEqTo(m1, p1) =>
          match whnf_c(k, m1) {
            MkRedTo(mw, pw) => {
              let conv : EqTo(k, mw) = match inspect(view(k, mw)) {
                MkSing(VNatLit(n), ev) => MkEqTo(nat_lit_to_ctor(k, n), DRed(RNatLit(ev)))
                MkSing(VStrLit(str), ev) =>
                  match whnf_c(k, str_lit_to_ctor(k, str)) {
                    MkRedTo(c2, p2) => MkEqTo(c2, DRed(RTrans(RStrLit(ev), p2)))
                  }
                MkSing(_, _) => to_ctor_when_struct_c(k, major_induct, mw)
              }
              match conv {
                MkEqTo(c, pc) =>
                  match inspect(iota_apply(k, e, c)) {
                    MkSing(Some(r), er) => {
                      bump(k, ST_IOTA)
                      Some(MkRedTo(r, RIota(em, DTrans(p1, DTrans(DRed(pw), pc)), er)))
                    }
                    MkSing(None, _) => None
                  }
              }
            }
          }
      }
    }
    MkSing(None, _) => None
  }
}

fn reduce_recursor_c(k : K, e : Expr) -> RedTo(k, e)? raise KernelError {
  if k.env.quot_init {
    match quot_reduce_c(k, e) {
      Some(r) => return Some(r)
      None => ()
    }
  }
  inductive_reduce_c(k, e)
}
